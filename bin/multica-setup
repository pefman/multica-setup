#!/usr/bin/env python3
"""multica-setup — bootstrap a working Multica project team.

Run it bare for the interactive menu (new project wizard, or pick an
existing manifest to check/plan/apply/status/smoke/kickoff/teardown), or use
a subcommand directly.

Reads a project manifest (see templates/project.schema.md) and creates or
updates the whole setup through the `multica` CLI: workspace, repositories,
skills, agents, squad, project, and autopilots.

Subcommands:
  init      Interactive (or --auto) manifest authoring, then check/plan/apply/kickoff/smoke
  check     Pre-flight: CLI, auth, daemon, runtimes, templates (read-only)
  plan      What apply would create/update (read-only)
  apply     Create/update everything the manifest describes (idempotent)
  status    Show the live state of the target workspace
  smoke     Run a throwaway issue through the squad to prove the flow works
  kickoff   Open the kickoff issue: the lead pings the owner to start work
  teardown  Archive everything this tool created (needs --yes)

Everything talks to Multica through the `multica` CLI; nothing here touches
your CLI profile or daemon.
"""

from __future__ import annotations

import argparse
import json
import os
import random
import re
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path

