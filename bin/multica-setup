}

# ---- output color (TTY only, so piped and --output json stays clean) ----

def _color(text, code):
    try:
        if not sys.stdout.isatty():
            return text
    except Exception:
        return text
    return "\033[%sm%s\033[0m" % (code, text)


def node_install_command():
    """argv for installing Node.js on this machine, or None."""
    if Path("/etc/arch-release").exists():
        return ["sudo", "pacman", "-S", "nodejs", "npm"]
    if shutil.which("apt-get"):
        return ["sudo", "apt-get", "install", "-y", "nodejs", "npm"]
    if shutil.which("dnf"):
        return ["sudo", "dnf", "install", "-y", "nodejs", "npm"]
    if shutil.which("brew"):
        return ["brew", "install", "node"]
    return None


def detect_node_install():
    """Human-readable install hint for this machine."""
    cmd = node_install_command()
    if cmd:
        return " ".join(cmd)
    return "install Node.js 20+ from https://nodejs.org"

ROLE_BLURBS = {
    "lead": "Coordinates the team: triage, routing, tracking, delivery to the owner. Never implements.",
    "engineer": "Builds features and fixes in the registered repositories. Delivers as PRs.",
    "reviewer": "Fresh-eyes code review against the issue's requirements. Comments only, never edits.",
    "qa": "Verifies delivered work at runtime: tests, acceptance criteria, regressions.",
    "release": "Prepares and executes approved releases and deploys. Never merges, never ships unapproved work.",
    "docs": "Owns the repositories' documentation: keeps README/docs/CHANGELOG in sync with code; closes docs-check gaps as PRs.",
    "helper": "Workspace office: issue triage support, board hygiene, answers. Never touches code.",
}

NO_WS_CMDS = {"auth", "daemon", "login", "setup", "config", "update", "version", "user"}

ROUTING_POLICY = {
    "hybrid": (
        "Routing policy: hybrid. Assign work to the squad; when the owner of a "
        "piece of work is unambiguous (e.g. a single-agent fix or review), a "
        "direct assignment to that member is fine and faster."
    ),
    "leader-only": (
        "Routing policy: leader-only. Every issue goes through this squad; "
        "never assign directly to a member. You are the single entry point."
    ),
}

PROJECT_SCOPING = (
    "\n\n## Project scoping\n"
    "Work in this workspace is organized into projects, and each project has "
    "its own registered repositories. Every issue belongs to exactly one "
    "project.\n"
    "- Before touching a repository, check which project the issue belongs to, "
    "and work **only** in that project's registered repositories.\n"
    "- A repository registered under a different project is out of scope for "
    "this issue, even if you can see it.\n"
    "- If the issue has no project, or you are unsure which project — and "
    "therefore which repositories — the work should land in: do **not** guess. "
    "Ask the project owner on the issue (one clear question) and set it "
    "`blocked` until you get an answer."
)


class MulticaError(Exception):
    pass


class ManifestError(Exception):
    pass


# ---------------------------------------------------------------------------
# Multica CLI client — every Multica call goes through the `multica` binary
# ---------------------------------------------------------------------------

class Multica:
    def __init__(self, workspace_id=None, profile=None):
        self.workspace_id = workspace_id
        self.profile = profile

    def run(self, args, stdin=None, want_json=False, timeout=180):
        cmd = ["multica", *args]
        if self.profile:
            cmd += ["--profile", self.profile]
        if self.workspace_id and args[0] not in NO_WS_CMDS:
            cmd += ["--workspace-id", self.workspace_id]
        try:
            p = subprocess.run(cmd, input=stdin, capture_output=True, text=True, timeout=timeout)
        except FileNotFoundError:
            raise MulticaError("multica CLI not found on PATH — install it first (see docs/runbook.md)")
        except subprocess.TimeoutExpired:
            raise MulticaError(f"timed out after {timeout}s: multica {' '.join(args)}")
        if p.returncode != 0:
            err = (p.stderr or p.stdout or "").strip()
            raise MulticaError(f"`multica {' '.join(args)}` failed:\n{err[:2000]}")
        if want_json:
            out = p.stdout.strip()
            if not out:
                return None
            try:
                return json.loads(out)
            except json.JSONDecodeError:
                return out
        return p.stdout

    def j(self, args, stdin=None, timeout=180):
        return self.run(args + ["--output", "json"], stdin=stdin, want_json=True, timeout=timeout)

    # -- workspaces ---------------------------------------------------------
    def workspace_list(self):
        return self.j(["workspace", "list"]) or []

    def workspace_create(self, name, slug, issue_prefix=None, description=None):
        args = ["workspace", "create", "--name", name, "--slug", slug]
        if issue_prefix:
            args += ["--issue-prefix", issue_prefix]
        stdin = None
        if description:
            args += ["--description-stdin"]
            stdin = description
        return self.j(args, stdin=stdin)

    # -- runtimes / auth / daemon -------------------------------------------
    def runtime_list(self):
        return self.j(["runtime", "list"]) or []

    def auth_status(self):
        return self.run(["auth", "status"])

    def daemon_status(self):
        return self.j(["daemon", "status"])

    # -- skills --------------------------------------------------------------
    def skill_list(self):
        return self.j(["skill", "list"]) or []

    def skill_create(self, name, description, content_file):
        args = ["skill", "create", "--name", name, "--content-file", str(content_file)]
        if description:
            args += ["--description", description]
        return self.j(args)

    def skill_update(self, sid, name=None, description=None, content_file=None):
        args = ["skill", "update", sid]
        if name:
            args += ["--name", name]
        if description:
            args += ["--description", description]
        if content_file:
            args += ["--content-file", str(content_file)]
        return self.j(args)

    def skill_files_list(self, sid):
        return unwrap_list(self.j(["skill", "files", "list", sid]))

    def skill_file_upsert(self, sid, path, content_file):
        return self.j(["skill", "files", "upsert", sid, "--path", path, "--content-file", str(content_file)])

    def skill_file_delete(self, sid, path):
        return self.j(["skill", "files", "delete", sid, "--path", path])

    def skill_delete(self, sid):
        return self.run(["skill", "delete", sid, "--yes"])

    def skill_import_url(self, url):
        return self.j(["skill", "import", "--url", url, "--on-conflict", "skip"])

    # -- agents ---------------------------------------------------------------
    def agent_list(self, include_archived=False):
        args = ["agent", "list"]
        if include_archived:
            args.append("--include-archived")
        return self.j(args) or []

    def agent_create(self, name, runtime_id, instructions, description=None, model=None,
                     thinking_level=None, max_concurrent_tasks=None):
        args = ["agent", "create", "--name", name, "--runtime-id", runtime_id,
                "--instructions", instructions,
                "--permission-mode", "public_to", "--public-to-workspace"]
        if description:
            args += ["--description", description]
        if model:
            args += ["--model", model]
        if thinking_level:
            args += ["--thinking-level", thinking_level]
        if max_concurrent_tasks:
            args += ["--max-concurrent-tasks", str(max_concurrent_tasks)]
        return self.j(args)

    def agent_update(self, aid, instructions=None, model=None, clear_model=False,
                     thinking_level=None, clear_thinking=False,
                     max_concurrent_tasks=None, runtime_id=None):
        args = ["agent", "update", aid,
                "--permission-mode", "public_to", "--public-to-workspace"]
        if instructions is not None:
            args += ["--instructions", instructions]
        if model is not None:
            args += ["--model", model]
        elif clear_model:
            args += ["--model", ""]
        if thinking_level is not None:
            args += ["--thinking-level", thinking_level]
        elif clear_thinking:
            args += ["--thinking-level", ""]
        if max_concurrent_tasks is not None:
            args += ["--max-concurrent-tasks", str(max_concurrent_tasks)]
        if runtime_id is not None:
            args += ["--runtime-id", runtime_id]
        return self.j(args)

    def agent_archive(self, aid):
        return self.j(["agent", "archive", aid])

    def agent_restore(self, aid):
        return self.j(["agent", "restore", aid])

    def agent_skills_set(self, aid, skill_ids):
        if not skill_ids:
            return None
        return self.j(["agent", "skills", "set", aid, "--skill-ids", ",".join(skill_ids)])

    def agent_skills_list(self, aid):
        return unwrap_list(self.j(["agent", "skills", "list", aid]))

    # -- squads ----------------------------------------------------------------
    def squad_list(self):
        return self.j(["squad", "list"]) or []

    def squad_create(self, name, leader, description=None):
        args = ["squad", "create", "--name", name, "--leader", leader]
        if description:
            args += ["--description", description]
        return self.j(args)

    def squad_update(self, sid, instructions=None, leader=None, description=None):
        args = ["squad", "update", sid]
        if instructions is not None:
            args += ["--instructions", instructions]
        if leader is not None:
            args += ["--leader", leader]
        if description is not None:
            args += ["--description", description]
        return self.j(args)

    def squad_delete(self, sid):
        return self.j(["squad", "delete", sid])

    def squad_member_list(self, sid):
        return self.j(["squad", "member", "list", sid]) or []

    def squad_member_add(self, sid, member_id, role_line):
        return self.j(["squad", "member", "add", sid, "--member-id", member_id,
                       "--type", "agent", "--role", role_line])

    # -- autopilots --------------------------------------------------------------
    def autopilot_list(self):
        return unwrap_list(self.j(["autopilot", "list"]))

    def autopilot_get(self, aid):
        return self.j(["autopilot", "get", aid])

    def autopilot_create(self, title, agent, mode, description, issue_title=None,
                         project_id=None):
        args = ["autopilot", "create", "--title", title, "--agent", agent,
                "--mode", mode, "--description", description]
        if issue_title:
            args += ["--issue-title-template", issue_title]
        if project_id:
            args += ["--project", project_id]
        return self.j(args)

    def autopilot_update(self, aid, description=None, title=None, agent=None,
                         issue_title=None, project_id=None):
        args = ["autopilot", "update", aid]
        if description is not None:
            args += ["--description", description]
        if title is not None:
            args += ["--title", title]
        if agent is not None:
            args += ["--agent", agent]
        if issue_title is not None:
            args += ["--issue-title-template", issue_title]
        if project_id is not None:
            args += ["--project", project_id]
        return self.j(args)

    def autopilot_delete(self, aid):
        return self.run(["autopilot", "delete", aid])

    def autopilot_trigger_add(self, aid, cron, timezone, label=None):
        args = ["autopilot", "trigger-add", aid, "--kind", "schedule",
                "--cron", cron, "--timezone", timezone]
        if label:
            args += ["--label", label]
        return self.j(args)

    def autopilot_trigger_update(self, aid, trigger_id, cron=None, timezone=None):
        args = ["autopilot", "trigger-update", aid, trigger_id]
        if cron:
            args += ["--cron", cron]
        if timezone:
            args += ["--timezone", timezone]
        return self.j(args)

    # -- projects / repos ----------------------------------------------------------
    def project_list(self):
        return self.j(["project", "list"]) or []

    def project_create(self, title, description, lead=None, repos=()):
        args = ["project", "create", "--title", title]
        if description:
            args += ["--description", description]
        if lead:
            args += ["--lead", lead]
        for r in repos:
            args += ["--repo", r]
        return self.j(args)

    def project_update(self, pid, description=None, lead=None, title=None):
        args = ["project", "update", pid]
        if description is not None:
            args += ["--description", description]
        if lead is not None:
            args += ["--lead", lead]
        if title is not None:
            args += ["--title", title]
        return self.j(args)

    def project_delete(self, pid):
        return self.j(["project", "delete", pid])

    def project_resource_list(self, pid):
        return unwrap_list(self.j(["project", "resource", "list", pid]))

    def project_resource_add(self, pid, url, label=None):
        args = ["project", "resource", "add", pid, "--type", "github_repo", "--url", url]
        if label:
            args += ["--label", label]
        return self.j(args)

    def workspace_mcp_list(self):
        return self.j(["workspace", "mcp", "list"]) or []

    def workspace_mcp_add(self, name, cfg):
        # config via file, never on the command line (tokens must not hit
        # shell history or ps)
        path = write_tmp(json.dumps(cfg))
        try:
            return self.j(["workspace", "mcp", "add", name, "--server-config-file", str(path)])
        finally:
            os.unlink(path)

    def agent_mcp_list(self, agent_id):
        return unwrap_list(self.j(["agent", "mcp", "list", agent_id])) or []

    def agent_mcp_add(self, agent_id, server_id):
        return self.j(["agent", "mcp", "add", agent_id, server_id])

    def agent_mcp_remove(self, agent_id, server_id):
        return self.j(["agent", "mcp", "remove", agent_id, server_id])

    def repo_list(self):
        return unwrap_list(self.j(["repo", "list"]))

    def repo_add(self, urls):
        return self.j(["repo", "add", *urls])

    # -- issues ---------------------------------------------------------------------
    def issue_create(self, title, description=None, status=None, assignee=None,
                     project_id=None):
        args = ["issue", "create", "--title", title]
        if status:
            args += ["--status", status]
        if assignee:
            args += ["--assignee", assignee]
        if project_id:
            args += ["--project", project_id]
        stdin = None
        if description is not None:
            args += ["--description-stdin"]
            stdin = description
        return self.j(args, stdin=stdin)

    def issue_status(self, issue, status, no_start=True):
        args = ["issue", "status", issue, status]
        if no_start:
            args += ["--no-start"]
        return self.j(args)

    def issue_comment_list(self, issue):
        return unwrap_list(self.j(["issue", "comment", "list", issue]))

    def issue_runs(self, issue):
        return unwrap_list(self.j(["issue", "runs", issue]))

    def issue_cancel_task(self, task_id, issue=None):
        args = ["issue", "cancel-task", task_id]
        if issue:
            args += ["--issue", issue]
        return self.j(args)

    def issue_subscribe(self, issue):
        return self.j(["issue", "subscriber", "add", issue])


def unwrap_list(x):
    if x is None:
        return []
    if isinstance(x, list):
        return x
    if isinstance(x, dict):
        for v in x.values():
            if isinstance(v, list):
                return v
    return []


# ---------------------------------------------------------------------------
# Manifest
# ---------------------------------------------------------------------------

@dataclass
class Manifest:
    workspace: dict
    projects: list
    team: dict
    autopilots: list
    mcp: dict
    path: Path

    @property
    def roles(self):
        return self.team["roles"]

    @property
    def project(self):
        return self.projects[0]

    @property
    def all_repos(self):
        out = []
        for p in self.projects:
            for r in p.get("repos", []):
                if r not in out:
                    out.append(r)
        return out

    @property
    def mcp_servers(self):
        return (self.mcp or {}).get("servers", {})

    def mcp_attached(self, role):
        """Servers attached to this role (empty when no mcp section)."""
        servers = self.mcp_servers
        if not servers:
            return {}
        att = (self.mcp or {}).get("attach_to", "all")
        if att == "all" or role in (att or []):
            return servers
        return {}

    def roles_by_role(self):
        return {r["role"]: r for r in self.roles}

    def agent_names_by_role(self):
        return {r["role"]: r["name"] for r in self.roles}

    def squad_roles(self):
        return [r for r in self.roles if r.get("in_squad", True)]


def parse_manifest(raw: dict, path=None) -> Manifest:
    ws = raw.get("workspace")
    if not ws or ws.get("mode") not in ("existing", "new"):
        raise ManifestError("workspace.mode must be 'existing' or 'new'")
    if ws["mode"] == "existing" and not ws.get("slug"):
        raise ManifestError("workspace.slug is required when mode is 'existing'")
    if ws["mode"] == "new" and not (ws.get("name") and ws.get("slug")):
        raise ManifestError("workspace.name and workspace.slug are required when mode is 'new'")

    team = raw.get("team") or {}
    if not team.get("squad_name"):
        raise ManifestError("team.squad_name is required")
    if team.get("routing", "hybrid") not in ("hybrid", "leader-only"):
        raise ManifestError("team.routing must be 'hybrid' or 'leader-only'")
    roles = team.get("roles") or []
    if not roles:
        raise ManifestError("team.roles is required (at least the lead)")
    seen = set()
    for r in roles:
        if r.get("role") not in ROLES:
            raise ManifestError(f"unknown role '{r.get('role')}' (valid: {', '.join(ROLES)})")
        for k in ("role", "name", "runtime"):
            if not r.get(k):
                raise ManifestError(f"team.roles entry missing '{k}': {r}")
        if r["role"] in seen:
            raise ManifestError(f"duplicate role '{r['role']}' in team.roles")
        seen.add(r["role"])
    if "lead" not in seen:
        raise ManifestError("team.roles must include a 'lead' role (squad leader)")
    for s in team.get("skills", []):
        if not s.get("name") or s.get("source") not in ("local", "url"):
            raise ManifestError(f"team.skills entry invalid: {s}")
        if s["source"] == "local" and not (SKILLS_DIR / s["name"] / "SKILL.md").exists():
            raise ManifestError(f"local skill folder missing: skills/{s['name']}/SKILL.md")
        if s["source"] == "url" and not s.get("url"):
            raise ManifestError(f"skill '{s['name']}' has source 'url' but no url")

    if raw.get("projects") is not None:
        if raw.get("project") is not None:
            raise ManifestError("use either 'project' (single) or 'projects' (list) — not both")
        projects_raw = raw.get("projects")
        if not isinstance(projects_raw, list) or not projects_raw:
            raise ManifestError("projects must be a non-empty list of project objects")
    else:
        projects_raw = [raw.get("project") or {}]
    projects = []
    seen_names = set()
    for pr in projects_raw:
        if not pr.get("name"):
            raise ManifestError("project entry missing 'name'")
        if not pr.get("description"):
            raise ManifestError(f"project '{pr['name']}' missing 'description' (it enters every run's context)")
        if pr.get("lead_role") and pr["lead_role"] not in seen:
            raise ManifestError(f"project '{pr['name']}' lead_role '{pr['lead_role']}' is not a team role")
        if pr["name"] in seen_names:
            raise ManifestError(f"duplicate project name '{pr['name']}'")
        seen_names.add(pr["name"])
        projects.append({
            "name": pr["name"],
            "description": pr["description"],
            "repos": list(pr.get("repos", [])),
            "lead_role": pr.get("lead_role", "lead"),
        })

    autopilots = []
    for a in raw.get("autopilots", []):
        for k in ("key", "name", "assignee_role"):
            if not a.get(k):
                raise ManifestError(f"autopilot entry missing '{k}': {a}")
        if a["assignee_role"] not in seen:
            raise ManifestError(f"autopilot '{a['name']}' assigns unknown role '{a['assignee_role']}'")
        if a.get("project") and a["project"] not in seen_names:
            raise ManifestError(f"autopilot '{a['name']}' lands in unknown project '{a['project']}'")
        if a.get("mode") not in (None, "create_issue", "run_only"):
            raise ManifestError(f"autopilot '{a['name']}' mode must be create_issue or run_only")
        runbook = AUTOPILOTS_DIR / f"{a['key']}.md"
        if not runbook.exists():
            raise ManifestError(f"autopilot runbook missing: autopilots/{a['key']}.md")
        mode = a.get("mode", "create_issue")
        if mode == "create_issue" and not a.get("issue_title"):
            raise ManifestError(f"autopilot '{a['name']}' (create_issue) needs issue_title")
        autopilots.append({
            "key": a["key"], "name": a["name"], "assignee_role": a["assignee_role"],
            "mode": mode, "cron": a.get("cron", "0 9 * * *"),
            "timezone": a.get("timezone", "UTC"), "issue_title": a.get("issue_title"),
            "project": a.get("project"),
        })

    mcp = raw.get("mcp") or {}
    for name, cfg in (mcp.get("servers") or {}).items():
        if not isinstance(cfg, dict) or not (cfg.get("url") or cfg.get("command")):
            raise ManifestError(f"mcp.servers['{name}'] needs 'url' (http) or 'command' (stdio): {cfg}")
    attach = mcp.get("attach_to", "all")
    if attach != "all" and (not isinstance(attach, list) or any(r not in seen for r in attach)):
        raise ManifestError(f"mcp.attach_to must be 'all' or a list of known roles: {attach}")

    return Manifest(workspace=ws, projects=projects, team=team,
                    autopilots=autopilots, mcp=mcp, path=path or Path("."))


def load_manifest(path: Path) -> Manifest:
    if not path.exists():
        raise ManifestError(f"manifest not found: {path}")
    try:
        raw = json.loads(path.read_text())
    except json.JSONDecodeError as e:
        raise ManifestError(f"manifest is not valid JSON: {e}")
    return parse_manifest(raw, path)


# ---- spec storage: local file, or inside Multica (project description) ----
SPEC_TAG = "multica-setup-spec"


def spec_block(spec_dict):
    return f"<!-- {SPEC_TAG} v1\n{json.dumps(spec_dict, indent=2, ensure_ascii=False)}\n-->"


def split_description(desc):
    """(human text, spec dict or None) — the spec rides in an HTML comment."""
    text = desc or ""
    m = re.search(r"<!--\s*" + SPEC_TAG + r" v1\n(.*?)\n-->", text, re.S)
    if not m:
        return text, None
    human = (text[: m.start()] + text[m.end():]).strip()
    try:
        return human, json.loads(m.group(1))
    except json.JSONDecodeError:
        return text, None


def store_description(human_text, spec_dict):
    return f"{(human_text or '').strip()}\n\n{spec_block(spec_dict)}"


def get_spec(args):
    """(manifest, spec dict, mode) for --manifest, --workspace, or injected.

    mode is 'file', 'cli', or 'injected' (init --in-project hands the spec
    to the chain in memory before the project exists)."""
    injected = getattr(args, "_spec", None)
    if injected:
        return injected[0], injected[1], "injected"
    if getattr(args, "manifest", None):
        path = Path(args.manifest)
        return load_manifest(path), json.loads(path.read_text()), "file"
    if not getattr(args, "workspace", None):
        raise ManifestError("nothing to look up — pass --manifest <file> or --workspace <slug>")
    mc = make_mc(args)
    ws_id = target_workspace_id(mc, args, None)
    mc_ws = Multica(workspace_id=ws_id, profile=args.profile)
    want = getattr(args, "project", None)
    for p in mc_ws.project_list():
        if want and p.get("title") != want:
            continue
        _, spec = split_description(p.get("description") or "")
        if spec is None:
            continue
        man = parse_manifest(spec)
        if want and not any(pr["name"] == want for pr in man.projects):
            continue
        return man, spec, "cli"
    where = (f"workspace '{args.workspace}'"
             + (f" / project '{args.project}'" if getattr(args, "project", None) else ""))
    raise ManifestError(f"no multica-setup-managed project in {where} "
                        f"(managed projects carry their spec in the project description)")


def list_managed_projects(slug, profile=None):
    """Project titles in the workspace whose description carries a spec."""
    probe = argparse.Namespace(profile=profile, workspace=slug)
    mc = make_mc(probe)
    ws_id = target_workspace_id(mc, probe, None)
    mc_ws = Multica(workspace_id=ws_id, profile=profile)
    out = []
    for p in mc_ws.project_list():
        _, spec = split_description(p.get("description") or "")
        if spec is not None:
            out.append(p.get("title"))
    return out


# ---------------------------------------------------------------------------
# Template rendering
# ---------------------------------------------------------------------------

def split_frontmatter(text):
    if text.startswith("---\n"):
        end = text.find("\n---", 4)
        if end != -1:
            fm, body = text[4:end], text[end + 4:].lstrip("\n")
            name = re.search(r"^name:\s*(.+)$", fm, re.M)
            desc = re.search(r"^description:\s*(.+)$", fm, re.M)
            return (name.group(1).strip() if name else None,
                    desc.group(1).strip() if desc else None, body)
    return None, None, text


def render(template, ctx):
    def sub(m):
        key = m.group(1).strip()
        if key not in ctx:
            raise ManifestError(f"template placeholder '{{{{ {key} }}}}' has no value in context")
        return str(ctx[key])
    out = re.sub(r"\{\{\s*([^{}]+?)\s*\}\}", sub, template)
    leftover = re.findall(r"\{\{([^{}]+)\}\}", out)
    if leftover:
        raise ManifestError(f"unrendered template placeholders: {leftover}")
    return out


ROUTE_TABLE = [
    ("engineer", "Feature, fix, refactor in a repo"),
    ("reviewer", "Code review of a PR/branch"),
    ("qa", "Verify delivered behavior, run checks, regression pass"),
    ("release", "Prepare/execute an approved release or deploy"),
    ("docs", "Documentation: write/update in-repo docs, close docs-check gaps"),
    ("helper", "Issue triage, board hygiene, questions, workspace chores"),
]

ROUTE_BULLETS = [
    ("engineer", "Code that builds or fixes"),
    ("reviewer", "A PR or branch that needs a quality pass"),
    ("qa", "Delivered work that needs behavioral verification"),
    ("release", "A release or deploy the owner has approved"),
    ("docs", "Docs to write or keep in sync (incl. the 'Docs:' gap issues from docs-check)"),
    ("helper", "Triage, board hygiene, questions, workspace chores"),
]


def build_context(manifest, agent_ids=None):
    """Base render context shared by all templates."""
    names = {r["role"]: r["name"] for r in manifest.roles}
    sections = []
    for p in manifest.projects:
        repos = "\n".join(f"- {r}" for r in p.get("repos", [])) or "(no repositories registered)"
        sections.append(f"### {p['name']}\n{p['description']}\n\nRepositories:\n{repos}")
    table_rows = [f"| {what} | {names[role]} |" for role, what in ROUTE_TABLE if role in names]
    table_rows.append("| Anything ambiguous or cross-cutting | you route it |")
    bullet_rows = [f"- {what} → **{names[role]}** ({role})"
                    for role, what in ROUTE_BULLETS if role in names]
    bullet_rows.append(
        "- Cross-cutting, ambiguous, or multi-role work → you sequence it: "
        "delegate the first step, then route each member's output to the next.")
    ctx = {
        "projects_names": ", ".join(p["name"] for p in manifest.projects),
        "projects_section": "\n\n".join(sections),
        "repo_list": ("\n".join(f"- {r}" for r in manifest.all_repos)
                      or "(no repositories registered)"),
        "squad_name": manifest.team["squad_name"],
        "issue_prefix": manifest.workspace.get("issue_prefix", "MP").upper(),
        "roster": "\n".join(
            f"- **{r['name']}** ({ROLES[r['role']]}) — {r.get('squad_role') or ROLE_BLURBS[r['role']]}"
            for r in manifest.squad_roles()
        ),
        "routing_table": "| Work | First owner |\n|---|---|\n" + "\n".join(table_rows),
        "routing_bullets": "\n".join(bullet_rows),
    }
    for role, nm in names.items():
        ctx[f"{role}_name"] = nm
    return ctx


def render_agent_instructions(manifest, role_spec, base_ctx):
    tpl = (REPO_ROOT / "roles" / f"{role_spec['role']}.md").read_text()
    ctx = dict(base_ctx)
    ctx["name"] = role_spec["name"]
    if manifest.team.get("routing", "hybrid") == "leader-only" and role_spec["role"] == "lead":
        tpl += "\n\n" + ROUTING_POLICY["leader-only"]
    tpl += PROJECT_SCOPING
    attached = manifest.mcp_attached(role_spec["role"])
    if attached:
        lines = [f"- {MCP_BLURBS.get(n, f'{n} — MCP server; see its tool list for what it provides')}"
                 for n in attached]
        tpl += ("\n\n## MCP tools\n"
               "These MCP servers are attached to you on your runtime:\n"
               + "\n".join(lines) + "\nPrefer them over guessing or re-deriving what they provide.")
    return render(tpl, ctx)


def render_squad_instructions(manifest, base_ctx):
    tpl = (REPO_ROOT / "squad" / "squad-instructions.md").read_text()
    tpl += "\n\n" + ROUTING_POLICY[manifest.team.get("routing", "hybrid")]
    tpl += PROJECT_SCOPING
    return render(tpl, base_ctx)


def render_runbook(manifest, key, base_ctx):
    return render((AUTOPILOTS_DIR / f"{key}.md").read_text(), base_ctx)


def resolve_runtime(spec_runtime, runtimes):
    """Pick a runtime for a role: by ID, exact name, or provider."""
    if not runtimes:
        raise MulticaError("no runtimes registered in the target workspace — is the daemon online there?")
    for r in runtimes:
        if r.get("id") == spec_runtime:
            return r
    for r in runtimes:
        if (r.get("name") == spec_runtime or r.get("custom_name") == spec_runtime
                or r.get("provider") == spec_runtime):
            online = [x for x in runtimes if x["id"] == r["id"] and x.get("status") == "online"]
            if online:
                return online[0]
    matches = [r for r in runtimes if r.get("provider") == spec_runtime
               or r.get("name") == spec_runtime or r.get("custom_name") == spec_runtime]
    if matches:
        return matches[0]
    providers = sorted({r.get("provider", "?") for r in runtimes})
    raise MulticaError(
        f"no runtime matching '{spec_runtime}' in the workspace "
        f"(available providers: {', '.join(providers)}; "
        f"run `multica runtime list` for details)"
    )


ENV_REF = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}")
LOCAL_ENV_NAME = ".multica-setup.env"


def load_local_env(paths=None):
    """Load KEY=VALUE pairs from local env files into os.environ (no override).

    Checks .multica-setup.env then .env under cwd and REPO_ROOT. Existing
    environment values win. Returns the paths that contributed at least one var.
    """
    if paths is None:
        seen = []
        paths = []
        for base in (Path("."), REPO_ROOT):
            for name in (LOCAL_ENV_NAME, ".env"):
                p = (base / name).resolve()
                if p not in seen:
                    seen.append(p)
                    paths.append(p)
    loaded = []
    for path in paths:
        path = Path(path)
        if not path.is_file():
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except OSError:
            continue
        n = 0
        for line in text.splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, _, v = line.partition("=")
            k = k.strip()
            v = v.strip().strip("'").strip('"')
            if not k or k in os.environ:
                continue
            os.environ[k] = v
            n += 1
        if n:
            loaded.append(str(path))
    return loaded


def save_local_env_var(name, value, path=None):
    """Write or replace NAME=value in .multica-setup.env (gitignored)."""
    path = Path(path) if path else Path(LOCAL_ENV_NAME)
    lines = []
    if path.exists():
        try:
            lines = path.read_text(encoding="utf-8").splitlines(True)
        except OSError:
            lines = []
    out = []
    found = False
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            out.append(line if line.endswith("\n") else line + "\n")
            continue
        key = stripped.split("=", 1)[0].strip()
        if key == name:
            out.append("%s=%s\n" % (name, value))
            found = True
        else:
            out.append(line if line.endswith("\n") else line + "\n")
    if not found:
        out.append("%s=%s\n" % (name, value))
    path.write_text("".join(out), encoding="utf-8")
    try:
        os.chmod(path, 0o600)
    except OSError:
        pass
    os.environ[name] = value
    return path


def expand_env_refs(cfg, where):
    """Expand ${VAR} references from the environment; fail clearly if unset.

    Keys are referenced by name in the manifest — values never live in the
    repo. This keeps API tokens out of git while the CLI gets them on apply.
    """
    def sub(v):
        if not isinstance(v, str):
            return v
        missing = [m for m in ENV_REF.findall(v) if not os.environ.get(m)]
        if missing:
            raise ManifestError(f"{where}: environment variable(s) not set: {', '.join(missing)}")
        return ENV_REF.sub(lambda m: os.environ[m.group(1)], v)
    out = {}
    for k, v in cfg.items():
        if isinstance(v, dict):
            out[k] = {kk: sub(vv) for kk, vv in v.items()}
        elif isinstance(v, list):
            out[k] = [sub(x) for x in v]
        else:
            out[k] = sub(v)
    return out


def write_tmp(content):
    import tempfile
    f = tempfile.NamedTemporaryFile("w", suffix=".md", delete=False, encoding="utf-8")
    f.write(content)
    f.close()
    return Path(f.name)

# ---------------------------------------------------------------------------
# State file (tracks what this tool created, for teardown/re-runs)
# ---------------------------------------------------------------------------

def state_path_for(manifest, override=None):
    if override:
        return Path(override)
    return manifest.path.parent / ".multica-bootstrap-state.json"


def load_state(path):
    if path.exists():
        return json.loads(path.read_text())
    return {"created": {}}


def save_state(path, state):
    path.write_text(json.dumps(state, indent=2) + "\n")


# ---------------------------------------------------------------------------
# Workspace resolution
# ---------------------------------------------------------------------------

def resolve_workspace(mc, manifest, dry, actions):
    ws = manifest.workspace
    if ws["mode"] == "existing":
        for w in mc.workspace_list():
            if w.get("slug") == ws["slug"] or w.get("id") == ws["slug"]:
                return w["id"]
        raise ManifestError(
            f"workspace '{ws['slug']}' not found — check `multica workspace list`")
    # mode: new
    for w in mc.workspace_list():
        if w.get("slug") == ws["slug"]:
            return w["id"]
    actions.append(("workspace", f"create {ws['slug']} ({ws['name']})"))
    if not dry:
        try:
            created = mc.workspace_create(ws["name"], ws["slug"],
                                          ws.get("issue_prefix"), ws.get("description"))
        except MulticaError as e:
            if "slug already exists" in str(e):
                raise MulticaError(
                    f"workspace slug '{ws['slug']}' is already taken — slugs are global "
                    f"across ALL users on Multica Cloud, so short/generic slugs are often "
                    f"owned by other accounts.\n"
                    f"Fix: change workspace.slug in the manifest and re-run apply, or run\n"
                    f"      bin/multica-setup init --workspace {ws['slug']} to manage the existing workspace") from e
            raise
        wid = None
        if isinstance(created, dict):
            wid = created.get("id") or (created.get("workspace") or {}).get("id")
        if not wid:
            for w in mc.workspace_list():
                if w.get("slug") == ws["slug"]:
                    wid = w["id"]
                    break
        if not wid:
            raise MulticaError(f"workspace created but ID not found: {created!r}")
        print(f"note: new workspace '{ws['slug']}' created — if its runtimes do not "
              f"appear, the daemon may need a re-login/restart to register them")
        return wid
    # dry: unknown id, use slug as placeholder
    return f"dry-run:{ws['slug']}"


# ---------------------------------------------------------------------------
# Apply steps (each is dry-run aware)
# ---------------------------------------------------------------------------

class Plan:
    def __init__(self, dry):
        self.dry = dry

    def _tag(self, kind):
        code = {"create": "32", "import": "32", "update": "36",
                "restore": "33", "delete": "31"}.get(kind)
        if not code:
            return f"[{kind:6}]"
        return _color(f"[{kind:6}]", code)

    def log(self, kind, what, detail=None):
        verb = "would" if self.dry else "will" if kind == "create" else ("updated" if not self.dry else "would update")
        line = f"{self._tag(kind)} {what}"
        if detail:
            line += f" — {detail}"
        print(line)

    def ok(self, what, detail=None):
        line = f"[{_color('ok    ', '32')}] {what}"
        if detail:
            line += f" — {detail}"
        print(line)

    def action(self, kind, what, fn, detail=None):
        if self.dry:
            self.log(kind, what, detail)
            return
        print(self._tag(kind) + f" {what}" + (f" — {detail}" if detail else ""))
        fn()


def step_workspace_registry(mc, manifest, plan):
    repos = manifest.all_repos
    if not repos:
        return
    have = {r.get("url") for r in mc.repo_list()}
    missing = [u for u in repos if u not in have]
    if missing:
        plan.action("create", "workspace repos",
                    lambda: mc.repo_add(missing), f"{len(missing)} missing of {len(repos)}")
    else:
        plan.ok("workspace repos", f"{len(repos)} registered")


def step_skills(mc, manifest, plan):
    existing = {s.get("name"): s for s in mc.skill_list()}
    ids = {}
    for sk in manifest.team.get("skills", []):
        name = sk["name"]
        if sk["source"] == "local":
            folder = SKILLS_DIR / name
            skill_md = (folder / "SKILL.md").read_text()
            _, description, body = split_frontmatter(skill_md)
            support = [p for p in sorted(folder.rglob("*"))
                       if p.is_file() and p.name != "SKILL.md"]
            if name in existing:
                sid = existing[name]["id"]
                ids[name] = sid
                if plan.dry:
                    plan.log("update", f"skill {name}", "re-sync content + files (always re-pushed)")
                else:
                    plan.log("update", f"skill {name}", "re-sync content + files")
                    tmp = write_tmp(body)
                    try:
                        mc.skill_update(sid, name=name, description=description, content_file=tmp)
                        have = {f.get("path") for f in mc.skill_files_list(sid)}
                        for f in support:
                            rel = f.relative_to(folder).as_posix()
                            mc.skill_file_upsert(sid, rel, f)
                            have.discard(rel)
                        for stale in have:
                            if stale != "SKILL.md":
                                mc.skill_file_delete(sid, stale)
                    finally:
                        tmp.unlink(missing_ok=True)
            else:
                if plan.dry:
                    plan.log("create", f"skill {name}", f"local, {len(support)} supporting file(s)")
                    ids[name] = f"dry:{name}"
                else:
                    plan.log("create", f"skill {name}", f"local, {len(support)} supporting file(s)")
                    created = mc.skill_create(name, description, write_tmp_keep(body))
                    sid = extract_id(created)
                    ids[name] = sid
                    for f in support:
                        rel = f.relative_to(folder).as_posix()
                        mc.skill_file_upsert(sid, rel, f)
        else:
            if name in existing:
                ids[name] = existing[name]["id"]
                plan.ok(f"skill {name}", "already imported (url source)")
            elif plan.dry:
                plan.log("create", f"skill {name}", f"import from {sk['url']}")
                ids[name] = f"dry:{name}"
            else:
                plan.log("create", f"skill {name}", f"import from {sk['url']}")
                mc.skill_import_url(sk["url"])
                for s in mc.skill_list():
                    if s.get("name") == name:
                        ids[name] = s["id"]
                        break
    return ids


def write_tmp_keep(content):
    import tempfile
    f = tempfile.NamedTemporaryFile("w", suffix=".md", delete=False, encoding="utf-8")
    f.write(content)
    f.close()
    return Path(f.name)


def extract_id(obj):
    if isinstance(obj, str):
        return obj
    if isinstance(obj, dict):
        if "id" in obj:
            return obj["id"]
        for key in ("skill", "agent", "squad", "autopilot", "project", "workspace"):
            if isinstance(obj.get(key), dict) and "id" in obj[key]:
                return obj[key]["id"]
            if isinstance(obj.get(key), str):
                return obj[key]
    return None


def step_agents(mc, manifest, skill_ids, plan):
    runtimes = mc.runtime_list()
    existing = {a.get("name"): a for a in mc.agent_list(include_archived=True)}
    ctx = build_context(manifest)
    ids = {}
    for role in manifest.roles:
        rspec = role
        rt = resolve_runtime(rspec["runtime"], runtimes)
        online = rt.get("status") == "online"
        instructions = render_agent_instructions(manifest, rspec, ctx)
        seen, wanted = set(), []
        for s in manifest.team.get("skills", []):
            n = s["name"]
            if n in skill_ids and n not in seen and (
                    s.get("attach_to") == "all" or rspec["role"] in s.get("attach_to", [])):
                seen.add(n)
                wanted.append(n)
        skill_id_list = [skill_ids[n] for n in wanted]
        rt_note = f"runtime {rt.get('name') or rt['id']}" + ("" if online else " (OFFLINE)")

        if rspec["name"] in existing:
            a = existing[rspec["name"]]
            if a.get("archived_at"):
                if plan.dry:
                    plan.log("update", f"agent {rspec['name']}",
                             f"restore (archived) + {rt_note}")
                else:
                    mc.agent_restore(a["id"])
            changes = []
            if (a.get("instructions") or "") != instructions:
                changes.append("instructions")
            if (a.get("model") or "") != (rspec.get("model") or ""):
                changes.append("model")
            if a.get("runtime_id") != rt["id"]:
                changes.append("runtime")
            cur_mct = a.get("max_concurrent_tasks")
            if cur_mct is not None and cur_mct != rspec.get("max_concurrent_tasks", 1):
                changes.append("concurrency")
            if not plan.dry:
                cur_skills = {s.get("id") for s in mc.agent_skills_list(a["id"])}
                if cur_skills != set(skill_id_list):
                    changes.append("skills")
            if changes:
                if plan.dry:
                    plan.log("update", f"agent {rspec['name']}", f"{', '.join(changes)}; {rt_note}")
                else:
                    plan.log("update", f"agent {rspec['name']}", f"{', '.join(changes)}; {rt_note}")
                    upd = {}
                    if "instructions" in changes:
                        upd["instructions"] = instructions
                    if "model" in changes:
                        if rspec.get("model"):
                            upd["model"] = rspec["model"]
                        else:
                            upd["clear_model"] = True
                    if "runtime" in changes:
                        upd["runtime_id"] = rt["id"]
                    if "concurrency" in changes:
                        upd["max_concurrent_tasks"] = rspec.get("max_concurrent_tasks", 1)
                    mc.agent_update(a["id"], **upd)
                    if "skills" in changes:
                        mc.agent_skills_set(a["id"], skill_id_list)
            else:
                plan.ok(f"agent {rspec['name']}", rt_note)
            ids[rspec["name"]] = a["id"]
        else:
            detail = f"{ROLES[rspec['role']]}; {rt_note}"
            model = rspec.get("model")
            detail += f"; model {model}" if model else ""
            if plan.dry:
                plan.log("create", f"agent {rspec['name']}", detail)
                ids[rspec["name"]] = f"dry:{rspec['name']}"
            else:
                plan.log("create", f"agent {rspec['name']}", detail)
                created = mc.agent_create(
                    rspec["name"], rt["id"], instructions,
                    description=f"{ROLES[rspec['role']]} on {manifest.team['squad_name']}",
                    model=rspec.get("model"),
                    thinking_level=rspec.get("thinking_level"),
                    max_concurrent_tasks=rspec.get("max_concurrent_tasks", 1))
                aid = extract_id(created) or a_id_from_list(mc, rspec["name"])
                ids[rspec["name"]] = aid
                if skill_id_list:
                    mc.agent_skills_set(aid, skill_id_list)
    return ids


def a_id_from_list(mc, name):
    for a in mc.agent_list():
        if a.get("name") == name:
            return a["id"]
    raise MulticaError(f"agent created but not found in list: {name}")


def step_mcp(mc, manifest, agent_ids, plan, prev_managed=()):
    """Register MCP servers in the workspace library and assign them to agents.

    The library config is write-only on the server side (it may hold tokens),
    so an existing entry is never re-pushed or diffed — only missing entries
    are added. Removal: agent assignments of previously-managed servers that
    left the spec are dropped; library entries are kept (they may be shared).
    """
    servers = manifest.mcp_servers
    if not servers:
        return {}
    lib = {}
    try:
        lib = {s.get("name"): s.get("id") for s in mc.workspace_mcp_list() if s.get("name")}
    except MulticaError:
        pass
    for name in servers:
        if name in lib:
            plan.ok(f"mcp {name}", "in workspace library (config not diffable — left as-is)")
            continue
        plan.log("create", f"mcp {name}", "add to workspace library")
        if not plan.dry:
            cfg = expand_env_refs(servers[name], f"mcp server '{name}'")
            mc.workspace_mcp_add(name, cfg)
    try:
        lib = {s.get("name"): s.get("id") for s in mc.workspace_mcp_list() if s.get("name")}
    except MulticaError:
        pass
    attach = (manifest.mcp or {}).get("attach_to", "all")
    roles = [r["role"] for r in manifest.roles]
    targets = roles if attach == "all" else [r for r in roles if r in attach]
    names = manifest.agent_names_by_role()
    for name, sid in ((n, lib.get(n)) for n in servers):
        if not sid:
            continue
        for role in targets:
            aid = agent_ids.get(names.get(role, ""), "")
            if not aid:
                continue
            plan.log("create", f"mcp {name}", f"assigned to {role} agent (no-op if already assigned)")
            if not plan.dry:
                mc.agent_mcp_add(aid, sid)
    for name in prev_managed:
        if name in servers:
            continue
        sid = lib.get(name)
        for role in targets:
            aid = agent_ids.get(names.get(role, ""), "")
            if aid and sid and not plan.dry:
                try:
                    mc.agent_mcp_remove(aid, sid)
                except MulticaError:
                    pass
        plan.log("delete", f"mcp {name}",
                 "no longer in spec — unassigned; kept in workspace library "
                 "(remove manually with `multica workspace mcp remove` if unused)")
    return {n: lib.get(n) for n in servers}


def step_squad(mc, manifest, agent_ids, plan):
    name = manifest.team["squad_name"]
    lead_role = manifest.roles_by_role()["lead"]
    lead_name = lead_role["name"]
    leader_id = agent_ids[lead_name]
    ctx = build_context(manifest)
    instructions = render_squad_instructions(manifest, ctx)
    members = [(agent_ids[r["name"]], r.get("squad_role") or ROLE_BLURBS[r["role"]], r["name"])
               for r in manifest.squad_roles() if r["role"] != "lead"]

    existing = {s.get("name"): s for s in mc.squad_list()}
    if name in existing:
        s = existing[name]
        sid = s["id"]
        if plan.dry:
            plan.log("update", f"squad {name}", f"leader {lead_name}, {len(members)} members, instructions (always re-synced)")
        else:
            plan.log("update", f"squad {name}", "sync leader/members/instructions")
            cur_leader = s.get("leader_id")
            if cur_leader and cur_leader != leader_id:
                mc.squad_update(sid, leader=lead_name)
            cur_members = {m.get("member_id"): m for m in mc.squad_member_list(sid)}
            for mid, role_line, rname in members:
                if mid not in cur_members:
                    mc.squad_member_add(sid, mid, role_line)
            mc.squad_update(sid, instructions=instructions)
        return sid
    if plan.dry:
        plan.log("create", f"squad {name}",
                f"leader {lead_name} + {', '.join(m[2] for m in members)}")
        sid = f"dry:{name}"
    else:
        plan.log("create", f"squad {name}",
                f"leader {lead_name} + {', '.join(m[2] for m in members)}")
        created = mc.squad_create(
            name, lead_name,
            description=f"Squad for {', '.join(p['name'] for p in manifest.projects)} — {manifest.team.get('routing', 'hybrid')} routing.")
        sid = extract_id(created)
        for mid, role_line, _ in members:
            mc.squad_member_add(sid, mid, role_line)
        mc.squad_update(sid, instructions=instructions)
    return sid


def step_projects(mc, manifest, agent_ids, plan, spec=None):
    """Create/update every project; the spec (in --in-project mode) rides in
    the first project's description."""
    first = True
    ids = {}
    for p in manifest.projects:
        title = p["name"]
        repos = p.get("repos", [])
        lead_name = agent_names_for_role(manifest, p.get("lead_role", "lead"))
        lead_id = agent_ids.get(lead_name) if lead_name else None
        existing = {x.get("title"): x for x in mc.project_list()}
        if title in existing:
            proj = existing[title]
            pid = proj["id"]
            changes = []
            if first and spec is not None:
                stored_human, stored_spec = split_description(proj.get("description") or "")
                if stored_human != (p["description"] or "").strip():
                    changes.append("description")
                elif stored_spec != spec:
                    changes.append("spec (embedded in description)")
            elif (proj.get("description") or "") != p["description"]:
                changes.append("description")
            if lead_id and proj.get("lead_id") and proj["lead_id"] != lead_id:
                changes.append("lead")
            if changes:
                if plan.dry:
                    plan.log("update", f"project {title}", ", ".join(changes))
                else:
                    plan.log("update", f"project {title}", ", ".join(changes))
                    upd = {}
                    if any(c.startswith("description") or c.startswith("spec") for c in changes):
                        upd["description"] = (store_description(p["description"], spec)
                                              if (first and spec is not None) else p["description"])
                    if "lead" in changes and lead_name:
                        upd["lead"] = lead_name
                    mc.project_update(pid, **upd)
            else:
                plan.ok(f"project {title}")
            _sync_project_repos(mc, pid, repos, plan)
            ids[title] = pid
            first = False
            continue
        detail = f"{len(repos)} repo(s)" + (f", lead {lead_name}" if lead_name else "")
        if plan.dry:
            plan.log("create", f"project {title}", detail)
        else:
            plan.log("create", f"project {title}", detail)
            desc = (store_description(p["description"], spec)
                    if (first and spec is not None) else p["description"])
            created = mc.project_create(title, desc, lead=lead_name, repos=repos)
            pid = extract_id(created)
            if not pid:
                for x in mc.project_list():
                    if x.get("title") == title:
                        pid = x["id"]
                        break
            ids[title] = pid
        first = False
    return ids


def agent_names_for_role(manifest, role):
    m = manifest.agent_names_by_role()
    return m.get(role, "")


def _sync_project_repos(mc, pid, repos, plan):
    if not repos:
        return
    try:
        cur = set()
        for r in mc.project_resource_list(pid):
            ref = r.get("resource_ref")
            if isinstance(ref, dict) and ref.get("url"):
                cur.add(ref["url"])
            if r.get("url"):
                cur.add(r["url"])
    except MulticaError:
        return
    missing = [u for u in repos if u not in cur]
    if missing:
        if plan.dry:
            plan.log("create", "project resources", f"{len(missing)} missing repo(s)")
        else:
            plan.log("create", "project resources", f"{len(missing)} missing repo(s)")
            for u in missing:
                mc.project_resource_add(pid, u)


def step_autopilots(mc, manifest, agent_ids, project_ids, plan):
    ctx = build_context(manifest)
    existing = {(a.get("name") or a.get("title")): a for a in mc.autopilot_list()}
    names = manifest.agent_names_by_role()
    for ap in manifest.autopilots:
        assignee = names.get(ap["assignee_role"], "")
        runbook = render_runbook(manifest, ap["key"], ctx)
        project_id = project_ids.get(ap.get("project") or manifest.projects[0]["name"])
        if ap["name"] in existing:
            a = existing[ap["name"]]
            aid = a["id"]
            raw = mc.autopilot_get(aid)
            det = raw.get("autopilot") if isinstance(raw, dict) and "autopilot" in raw else raw
            det = det or {}
            triggers = (raw.get("triggers") or []) if isinstance(raw, dict) else []
            diffs = []
            need_runbook = (det.get("description") or "") != runbook
            if need_runbook:
                diffs.append("runbook")
            need_title = (ap["mode"] == "create_issue" and ap.get("issue_title")
                          and (det.get("issue_title_template") or "") != ap["issue_title"])
            if need_title:
                diffs.append("issue title")
            need_project = (project_id and (det.get("project_id") in (None, "")
                                             or det.get("project_id") != project_id))
            if need_project:
                diffs.append("project")
            want_agent = agent_ids.get(assignee, "") if assignee else ""
            need_agent = bool(want_agent) and (det.get("assignee_id") or "") != want_agent
            if need_agent:
                diffs.append(f"assignee -> {assignee}")
            sched = next((t for t in triggers if t.get("kind") == "schedule"), None)
            need_trigger_add = sched is None
            need_trigger_upd = (not need_trigger_add and (
                sched.get("cron_expression") != ap["cron"] or sched.get("timezone") != ap["timezone"]))
            if need_trigger_add:
                diffs.append("schedule trigger")
            elif need_trigger_upd:
                diffs.append(f"schedule {sched.get('cron_expression')} → {ap['cron']} {ap['timezone']}")
            if diffs:
                plan.log("update", f"autopilot {ap['name']}", ", ".join(diffs))
                if not plan.dry:
                    if need_runbook:
                        mc.autopilot_update(aid, description=runbook)
                    if need_title:
                        mc.autopilot_update(aid, issue_title=ap["issue_title"])
                    if need_project:
                        mc.autopilot_update(aid, project_id=project_id)
                    if need_agent:
                        mc.autopilot_update(aid, agent=want_agent)
                    if need_trigger_add:
                        mc.autopilot_trigger_add(aid, ap["cron"], ap["timezone"], label=ap["name"])
                    elif need_trigger_upd:
                        mc.autopilot_trigger_update(aid, sched["id"], cron=ap["cron"],
                                                   timezone=ap["timezone"])
            else:
                plan.ok(f"autopilot {ap['name']}", f"cron {ap['cron']} {ap['timezone']}")
            continue
        detail = (f"assignee {assignee}, {ap['mode']}, cron {ap['cron']} {ap['timezone']}")
        if plan.dry:
            plan.log("create", f"autopilot {ap['name']}", detail)
        else:
            plan.log("create", f"autopilot {ap['name']}", detail)
            created = mc.autopilot_create(
                ap["name"], assignee, ap["mode"], runbook,
                issue_title=ap.get("issue_title") if ap["mode"] == "create_issue" else None,
                project_id=project_id)
            aid = extract_id(created)
            mc.autopilot_trigger_add(aid, ap["cron"], ap["timezone"], label=ap["name"])
    return None


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def make_mc(args, workspace_id=None):
    return Multica(workspace_id=workspace_id, profile=args.profile)


def target_workspace_id(mc, args, manifest=None):
    """Workspace to operate on: --workspace > manifest > profile default."""
    if args.workspace:
        for w in mc.workspace_list():
            if w.get("slug") == args.workspace or w.get("id") == args.workspace:
                return w["id"]
        raise ManifestError(f"workspace '{args.workspace}' not found")
    if manifest:
        ws = manifest.workspace
        if ws["mode"] == "existing":
            for w in mc.workspace_list():
                if w.get("slug") == ws["slug"] or w.get("id") == ws["slug"]:
                    return w["id"]
            raise ManifestError(
                f"workspace '{ws['slug']}' not found — is it in this account? "
                f"(`multica workspace list`)")
        for w in mc.workspace_list():
            if w.get("slug") == ws["slug"]:
                return w["id"]
        return None
    return None


def cmd_check(args):
    mc = make_mc(args)
    print("== multica-setup: pre-flight check ==")
    ok = True

    def report(level, what, detail=""):
        nonlocal ok
        mark = {"ok": "OK", "warn": "WARN", "fail": "FAIL"}[level]
        code = {"ok": "32", "warn": "33", "fail": "31"}[level]
        line = f"  {_color(f'[{mark}]', code)} {what}"
        if detail:
            line += f" — {detail}"
        print(line)
        if level == "fail":
            ok = False

    # CLI
    exe = shutil.which("multica")
    if not exe:
        report("fail", "multica CLI", "not found on PATH")
        return 1
    ver = subprocess.run([exe, "version"], capture_output=True, text=True).stdout.strip().splitlines()
    report("ok", "multica CLI", ver[0] if ver else exe)
    if ver and "0.4.26" not in ver[0]:
        major = re.search(r"multica (\d+)\.(\d+)\.(\d+)", ver[0])
        if major and (int(major.group(1)), int(major.group(2))) < (0, 5) and \
           (int(major.group(2)) < 4 or (int(major.group(2)) == 4 and int(major.group(3)) < 26)):
            report("warn", "multica version", f"{ver[0]} — the multica-cli skill needs >= 0.4.26")

    # auth
    try:
        out = mc.auth_status()
        m = re.search(r"Server:\s*(\S+)", out or "")
        report("ok", "auth", m.group(1) if m else "signed in")
    except MulticaError as e:
        report("fail", "auth", str(e).splitlines()[0])
        return 1

    # daemon
    try:
        d = mc.daemon_status()
        if d and d.get("status") == "running":
            report("ok", "daemon", f"{d.get('device_name', '?')} online, tools: {', '.join(d.get('agents', [])) or 'none detected'}")
        else:
            report("fail", "daemon", "not running — `multica daemon start`")
    except MulticaError as e:
        report("warn", "daemon", str(e).splitlines()[0])

    manifest = None
    if args.manifest:
        manifest = load_manifest(Path(args.manifest))
    else:
        try:
            manifest, _, _ = get_spec(args)
        except ManifestError:
            pass  # no managed project here — check CLI/auth/daemon only
    ws_id = None
    if manifest:
        # workspace
        try:
            ws_id = target_workspace_id(mc, args, manifest)
            if ws_id:
                report("ok", "workspace", f"{manifest.workspace.get('slug') or ws_id}")
            else:
                report("warn", "workspace",
                       f"new workspace '{manifest.workspace['slug']}' does not exist yet "
                       f"(apply will create it) — slugs are unique across ALL users on "
                       f"Multica Cloud; if apply fails with 'slug already exists', pick a longer/unique slug")
        except ManifestError as e:
            report("fail", "workspace", str(e))
            return 1

        # runtimes per role
        if ws_id and not ws_id.startswith("dry"):
            mc2 = Multica(workspace_id=ws_id, profile=args.profile)
            runtimes = mc2.runtime_list()
            online = {r["id"] for r in runtimes if r.get("status") == "online"}
            if not runtimes:
                report("fail", "runtimes", "none registered in this workspace — daemon may need a restart/re-login to pick it up")
            for r in manifest.roles:
                try:
                    rt = resolve_runtime(r["runtime"], runtimes)
                    if rt["id"] in online:
                        report("ok", f"role {r['role']} ({r['name']})", f"runtime {rt.get('name')} online")
                    else:
                        report("warn", f"role {r['role']} ({r['name']})",
                               f"runtime {rt.get('name')} is OFFLINE — tasks will queue until it is back")
                except MulticaError as e:
                    report("fail", f"role {r['role']} ({r['name']})", str(e))

        # templates
        try:
            ctx = build_context(manifest)
            for r in manifest.roles:
                render_agent_instructions(manifest, r, ctx)
            render_squad_instructions(manifest, ctx)
            for ap in manifest.autopilots:
                render_runbook(manifest, ap["key"], ctx)
            report("ok", "templates", "all role/squad/runbook templates render")
        except (ManifestError, OSError) as e:
            report("fail", "templates", str(e))

        # gh (only relevant with repos)
        if manifest.all_repos:
            if shutil.which("gh"):
                report("ok", "GitHub CLI", "available for PR-based verification")
            else:
                report("warn", "GitHub CLI", "not found — PR checks in reviews/deploys will be limited")

            # repo reachability — this machine is only a proxy for the runtime
            # machines, so failures are warnings, not failures
            for url in manifest.all_repos:
                label = url.split("://")[-1].rstrip("/")
                try:
                    r = subprocess.run(["git", "ls-remote", "--heads", url],
                                       capture_output=True, text=True, timeout=15)
                except (OSError, subprocess.SubprocessError) as e:
                    report("warn", f"repo {label}", f"probe failed ({e}) — the runtime machine still needs access")
                    continue
                if r.returncode == 0:
                    report("ok", f"repo {label}", "reachable from this machine")
                else:
                    detail = (r.stderr or r.stdout or "").strip().splitlines()
                    report("warn", f"repo {label}",
                           f"unreachable from this machine ({detail[0] if detail else 'git ls-remote failed'}) — the runtime machine still needs access")

        # git autopilots tip — optional; standup-only is the default
        ap_keys = {a["key"] for a in manifest.autopilots}
        missing_git = [d["key"] for d in GIT_AP_DEFS
                       if manifest.all_repos and d["key"] not in ap_keys]
        if missing_git:
            report("ok", "autopilots",
                   f"repos registered; optional git runbooks not enabled ({', '.join(missing_git)}) — add to manifest to opt in")

        # mcp servers — host prerequisites and unreferenced env vars
        for name, cfg in manifest.mcp_servers.items():
            for var in sorted({v for v in ENV_REF.findall(json.dumps(cfg)) if not os.environ.get(v)}):
                report("warn", f"mcp {name}",
                       f"references ${{'{var}'}} which is not set — put it in {LOCAL_ENV_NAME} "
                       "(or the environment) before apply")
            if "url" in cfg:
                report("ok", f"mcp {name}", "hosted server — no local prerequisites")
            for exe in MCP_PREREQS.get(name, (cfg.get("command"),)):
                if not exe:
                    continue
                if shutil.which(exe):
                    report("ok", f"mcp {name}", f"'{exe}' found on this machine")
                else:
                    report("warn", f"mcp {name}",
                           f"'{exe}' not found on this machine (stdio server) — the runtime machine needs it; "
                           f"install it there or the agent will not have this tool")

    verdict = "PASS" if ok else "FAIL"
    print("== " + _color(verdict, "32" if ok else "31"))
    return 0 if ok else 1


def run_apply(mc, args, manifest, spec=None, dry=False):
    plan = Plan(dry)
    print(f"== multica-setup: {'plan' if dry else 'apply'} for "
          f"{'workspace ' + (manifest.workspace.get('slug') or '?')} — "
          f"{', '.join(p['name'] for p in manifest.projects)} ==")
    ws_id = None
    if manifest.workspace["mode"] == "existing" or not dry:
        try:
            ws_id = target_workspace_id(mc, args, manifest)
        except ManifestError as e:
            print(_color("FAIL:", "31") + f": {e}")
            return 1
        if ws_id:
            mc.workspace_id = ws_id
    if manifest.workspace["mode"] == "new":
        ws_id = resolve_workspace(mc, manifest, dry, [])
        if ws_id and not str(ws_id).startswith("dry-run"):
            mc.workspace_id = ws_id
        if str(ws_id or "").startswith("dry-run") and dry:
            # Nothing exists yet: print what would be created, no live queries.
            n_skills = len(manifest.team.get("skills", []))
            cverb = _color("create", "32")
            print(f"workspace: {cverb} {manifest.workspace['slug']} ({manifest.workspace.get('name')})")
            for p in manifest.projects:
                print(f"project:   {cverb} {p['name']} ({len(p.get('repos', []))} repo(s))")
            for r in manifest.roles:
                print(f"agent:     {cverb} {r['name']} ({ROLES[r['role']]} on {r['runtime']})")
            print(f"skills:    {_color('create/import', '32')} {', '.join(s['name'] for s in manifest.team.get('skills', []))}")
            print(f"squad:     {cverb} {manifest.team['squad_name']} "
                  f"(leader {manifest.roles_by_role()['lead']['name']}, "
                  f"{sum(1 for r in manifest.squad_roles() if r['role'] != 'lead')} members)")
            for a in manifest.autopilots:
                print(f"autopilot: {cverb} {a['name']} (cron {a['cron']} {a['timezone']})")
            if manifest.mcp_servers:
                print(f"mcp:       {cverb} library entries: {', '.join(manifest.mcp_servers)} "
                      f"(assigned per attach_to)")
            print("\nplan complete — nothing was changed. Run `apply` to execute.")
            print("note: after `apply` creates the workspace, the daemon may need a "
                  "re-login/restart before its runtimes appear there.")
            return 0

    prev_state = {}
    if not dry and spec is None:
        prev_state = load_state(state_path_for(manifest, args.state))
    step_workspace_registry(mc, manifest, plan)
    skill_ids = step_skills(mc, manifest, plan)
    agent_ids = step_agents(mc, manifest, skill_ids, plan)
    step_mcp(mc, manifest, agent_ids, plan,
             prev_state.get("created", {}).get("mcp_servers", []))
    step_squad(mc, manifest, agent_ids, plan)
    project_ids = step_projects(mc, manifest, agent_ids, plan, spec)
    step_autopilots(mc, manifest, agent_ids, project_ids, plan)

    if not dry:
        if spec is None:
            state = prev_state
            state.update({
                "workspace_slug": manifest.workspace.get("slug"),
                "workspace_id": ws_id if ws_id and not str(ws_id).startswith("dry") else None,
                "project_ids": project_ids,
                "created": {
                    "agents": {n: i for n, i in agent_ids.items()},
                    "squad_name": manifest.team["squad_name"],
                    "skill_names": [s["name"] for s in manifest.team.get("skills", [])
                                    if s["source"] == "local"],
                    "autopilot_names": [a["name"] for a in manifest.autopilots],
                    "mcp_servers": list(manifest.mcp_servers),
                },
            })
            save_state(state_path_for(manifest, args.state), state)
            print(f"\nstate saved: {state_path_for(manifest, args.state)}")
        else:
            print(f"\nspec stored in project '{manifest.project['name']}' "
                  f"(workspace {manifest.workspace.get('slug')}) — manage it with:")
            print(f"  bin/multica-setup --workspace {manifest.workspace.get('slug')} "
                  f"--project {manifest.project['name']} <check|plan|apply|status|smoke|kickoff|teardown>")
        print("next: create an issue and assign it to the squad "
              f"({manifest.team['squad_name']}) — or run `smoke` to verify the flow end-to-end.")
    else:
        print("\nplan complete — nothing was changed. Run `apply` to execute.")
    return 0


def cmd_plan(args):
    mc = make_mc(args)
    man, spec, mode = get_spec(args)
    return run_apply(mc, args, man, None if mode == "file" else spec, dry=True)


def cmd_apply(args):
    mc = make_mc(args)
    man, spec, mode = get_spec(args)
    return run_apply(mc, args, man, None if mode == "file" else spec, dry=False)


def cmd_status(args):
    mc = make_mc(args)
    manifest = None
    if args.manifest:
        manifest = load_manifest(Path(args.manifest))
    elif args.workspace:
        try:
            manifest, _, _ = get_spec(args)
        except ManifestError:
            pass  # no managed project here — show raw workspace state
    ws_id = target_workspace_id(mc, args, manifest) if (args.workspace or manifest) else None
    if ws_id:
        mc.workspace_id = ws_id
    slug = manifest.workspace.get("slug") if manifest else args.workspace or "(profile default)"
    note = ""
    if manifest and manifest.workspace.get("mode") == "new" and not ws_id:
        note = " (not created yet — showing profile default workspace)"
    print(f"== multica-setup: status — workspace {slug}{note} ==")
    try:
        d = mc.daemon_status()
        if d and d.get("status") == "running":
            print(f"daemon: {d.get('device_name')} online — tools: {', '.join(d.get('agents', [])) or 'n/a'}")
        else:
            print("daemon: not running")
    except MulticaError as e:
        print(f"daemon: {e}")

    for r in mc.runtime_list():
        print(f"runtime: {r.get('name') or r.get('id'):<28} {r.get('provider'):<10} {r.get('status')}")

    agents = [a for a in mc.agent_list() if not a.get("system_key")]
    if agents:
        print(f"agents ({len(agents)}):")
        for a in agents:
            model = a.get("model") or "default"
            print(f"  {a.get('name'):<22} {model:<28} {a.get('status', '?')}")
    else:
        print("agents: none")

    squads = mc.squad_list()
    for s in squads:
        leader = s.get("leader_name") or s.get("leader_id") or "?"
        print(f"squad: {s.get('name')} (leader: {leader})")

    aps = mc.autopilot_list()
    for a in aps:
        trig = ""
        try:
            det = mc.autopilot_get(a["id"])
            for t in (det.get("triggers") or []):
                if t.get("kind") == "schedule":
                    trig = f" cron {t.get('cron_expression')} {t.get('timezone')}"
        except MulticaError:
            pass
        print(f"autopilot: {a.get('name') or a.get('title')} (assignee: {a.get('assignee_id')}, "
              f"mode: {a.get('execution_mode') or a.get('mode')}, status: {a.get('status') or a.get('pause_reason') or 'active'}{trig})")

    projs = mc.project_list()
    for p in projs:
        print(f"project: {p.get('title')} ({p.get('status')})")
    repos = mc.repo_list()
    for r in repos:
        print(f"repo: {r.get('url')}")

    try:
        issues = mc.j(["issue", "list", "--limit", "200"])
        if isinstance(issues, dict):
            issues = issues.get("issues") or []
        counts = {}
        for i in issues:
            if not isinstance(i, dict):
                continue
            counts[i.get("status", "?")] = counts.get(i.get("status", "?"), 0) + 1
        if counts:
            print("issues: " + ", ".join(f"{k}: {v}" for k, v in sorted(counts.items())))
    except MulticaError:
        pass
    return 0


def cmd_smoke(args):
    mc = make_mc(args)
    manifest, spec, mode = get_spec(args)
    ws_id = target_workspace_id(mc, args, manifest)
    if not ws_id:
        print(_color("FAIL:", "31") + ": target workspace not found")
        return 1
    mc.workspace_id = ws_id
    squads = {s.get("name"): s for s in mc.squad_list()}
    squad = manifest.team["squad_name"]
    if squad not in squads:
        print(_color("FAIL:", "31") + f": squad '{squad}' not found in workspace — run apply first")
        return 1

    issue_desc = (
        "Smoke test for the bootstrap flow. The squad leader should read this, "
        "record its evaluation, and post ONE delegation comment handing it to "
        "the member whose role fits (any member is fine for this test). "
        "No code, no PR: the delegated member should reply with one short "
        "comment confirming it received the handoff, using the handoff-protocol "
        "format (Done / Evidence / Questions / Ask). Then stop. "
        "This issue will be cancelled by the bootstrap tool afterwards."
    )
    project_id = None
    for p in mc.project_list():
        if p.get("title") == manifest.project["name"]:
            project_id = p["id"]
            break
    print(f"== multica-setup: smoke test via squad '{squad}' ==")
    created = mc.issue_create(
        f"Smoke: bootstrap flow test {time.strftime('%Y-%m-%d %H:%M')}",
        description=issue_desc, status="todo", assignee=squad, project_id=project_id)
    issue = None
    if isinstance(created, dict):
        issue = created.get("key") or created.get("identifier") or created.get("title")
        if not issue:
            for v in created.values():
                if isinstance(v, str) and re.match(r"^[A-Z]+-\d+$", v):
                    issue = v
                    break
    if not issue:
        print(_color("FAIL:", "31") + f": could not determine issue key from: {created!r}")
        return 1
    print(f"issue: {issue} (assigned to {squad}, status todo)")

    deadline = time.time() + args.timeout
    runs_seen, comments_seen = [], []
    evidence = []
    while time.time() < deadline:
        time.sleep(args.poll)
        try:
            runs = mc.issue_runs(issue)
            comments = mc.issue_comment_list(issue)
        except MulticaError as e:
            print(f"  poll: {e}")
            continue
        runs_seen = [r for r in runs if isinstance(r, dict)]
        comments_seen = [c for c in comments if isinstance(c, dict)]
        nonleader = [c for c in comments_seen
                     if not (c.get("author_name") or c.get("author") or "").lower().startswith(
                         manifest.roles_by_role()["lead"]["name"].lower())]
        if runs_seen:
            statuses = [r.get("status") for r in runs_seen]
            print(f"  runs: {len(runs_seen)} ({', '.join(statuses) or 'n/a'})")
        if any(c.get("content") or "" for c in comments_seen):
            dispatch = next((c for c in comments_seen
                             if "@mention" in (c.get("content") or "")
                             or "handoff" in (c.get("content") or "").lower()), None)
            if dispatch:
                print("  leader dispatch comment present")
            if nonleader:
                print(f"  member response present ({len(nonleader)} comment(s))")
            if dispatch and (nonleader or len(runs_seen) >= 2):
                evidence.append("full chain: leader dispatch + member response")
                break
            if dispatch:
                evidence.append("leader dispatched; waiting for member response")
    if not evidence:
        evidence.append("timeout — no full chain observed (runs/comments logged above)")
    print("evidence:", "; ".join(evidence) if evidence else "none")

    print("cleaning up...")
    try:
        for r in runs_seen:
            tid = r.get("id") or r.get("task_id")
            st = (r.get("status") or "").lower()
            if tid and st in ("queued", "dispatched", "running", "pending"):
                mc.issue_cancel_task(tid, issue=issue)
                print(f"  cancelled task {tid}")
        mc.issue_status(issue, "cancelled")
        print(f"issue {issue} cancelled")
    except MulticaError as e:
        print(f"cleanup note: {e}")
    passed = any("full chain" in e for e in evidence)
    verdict = _color("PASS", "32") if passed else _color("INCOMPLETE — inspect the issue before trusting the setup", "33")
    print("smoke: " + verdict)
    return 0 if passed else 2


def cmd_kickoff(args):
    mc = make_mc(args)
    manifest, spec, mode = get_spec(args)
    ws_id = target_workspace_id(mc, args, manifest)
    if not ws_id:
        print("FAIL: target workspace not found")
        return 1
    mc.workspace_id = ws_id
    squads = {s.get("name"): s for s in mc.squad_list()}
    squad = manifest.team["squad_name"]
    if squad not in squads:
        print(f"FAIL: squad '{squad}' not found in workspace — run apply first")
        return 1

    for i in unwrap_list(mc.j(["issue", "list", "--limit", "200"])):
        if not isinstance(i, dict):
            continue
        if (i.get("title") or "").startswith("Kickoff:") \
                and (i.get("status") or "") not in ("done", "cancelled"):
            key = i.get("key") or i.get("identifier") or i.get("id")
            print(f"kickoff: already open at {key} — nothing to do")
            return 0

    lead = manifest.roles_by_role()["lead"]["name"]
    issue_desc = (
        "Kickoff issue — there is no work here yet. This is your cue to greet the "
        "project owner. Do NOT delegate to a member and do NOT change the status. "
        "Post ONE comment to the project owner that: "
        "1. asks what we should start working on (one idea pitch is enough — "
        "a few sentences is fine, no spec needed); "
        "2. briefly says how we get started from a pitch: you turn it into one "
        "Feature with Research → Implement → Verify phases, open a start-decision "
        "ticket for the owner, and nothing starts building until the owner says "
        "go on that ticket — deliveries then land in `in_review` with a report, "
        "and the owner reviews and merges. "
        "Keep it short: the question first, then the three-line start plan. "
        "When the owner replies with a pitch, treat it as new scope: plan the "
        "Feature (see 'Feature planning'), open the start-decision ticket, link "
        "the resulting issues here, and close this kickoff issue yourself "
        "(`done --no-start`)."
    )
    project_id = None
    for p in mc.project_list():
        if p.get("title") == manifest.project["name"]:
            project_id = p["id"]
            break
    print(f"== multica-setup: kickoff via squad '{squad}' (lead: {lead}) ==")
    if len(manifest.projects) > 1:
        projs = {p["name"]: next((x["id"] for x in mc.project_list()
                                   if x.get("title") == p["name"]), None)
                 for p in manifest.projects}
    created_all = []
    for p in manifest.projects:
        pid = project_id if len(manifest.projects) == 1 else projs.get(p["name"])
        created = mc.issue_create(
            "Kickoff: what should we start working on?",
            description=issue_desc, status="todo", assignee=squad, project_id=pid)
        issue = None
        if isinstance(created, dict):
            issue = created.get("key") or created.get("identifier") or created.get("title")
            if not issue:
                for v in created.values():
                    if isinstance(v, str) and re.match(r"^[A-Z]+-\d+$", v):
                        issue = v
                        break
        if not issue:
            print(f"FAIL: could not determine issue key from: {created!r}")
            return 1
        created_all.append(issue)
        try:
            mc.issue_subscribe(issue)
        except MulticaError as e:
            print(f"note: could not subscribe the owner explicitly: {e}")
    for issue in created_all:
        print(f"issue: {issue} (assigned to {squad}, status todo)")
    print(f"the lead ({lead}) will comment on {created_all[0]} shortly and ping you in your inbox.")
    return 0


def cmd_teardown(args):
    if not args.yes:
        print("teardown archives agents, squads, autopilots, skills and the project it created.")
        print("pass --yes to proceed.")
        return 1
    manifest, spec, mode = get_spec(args)
    state = load_state(state_path_for(manifest, args.state)) if mode == "file" else {}
    created = state.get("created", {})
    probe = make_mc(args)
    ws_id = state.get("workspace_id") or target_workspace_id(probe, args, manifest)
    if not ws_id:
        print("FAIL: target workspace not found")
        return 1
    mc = make_mc(args, workspace_id=ws_id)
    ws_slug = state.get("workspace_slug") or manifest.workspace.get("slug")
    print(f"== multica-setup: teardown (workspace: {ws_slug}, spec: {mode}) ==")

    for name in (created.get("autopilot_names") or [a["name"] for a in manifest.autopilots]):
        for a in mc.autopilot_list():
            if a.get("name") == name or a.get("title") == name:
                mc.autopilot_delete(a["id"])
                print(f"archived autopilot: {name}")
    squad_name = created.get("squad_name") or manifest.team["squad_name"]
    for s in mc.squad_list():
        if s.get("name") == squad_name:
            mc.squad_delete(s["id"])
            print(f"archived squad: {squad_name} (its open issues transfer to the former leader)")
    agents = created.get("agents")
    if not agents:
        by_name = {a.get("name"): a["id"] for a in mc.agent_list()}
        agents = {r["name"]: by_name[r["name"]] for r in manifest.roles if r["name"] in by_name}
    for aname, aid in (agents or {}).items():
        try:
            mc.agent_archive(aid)
            print(f"archived agent: {aname}")
        except MulticaError as e:
            print(f"agent {aname}: {e}")
    for sname in (created.get("skill_names") or
                  [s["name"] for s in manifest.team.get("skills", []) if s["source"] == "local"]):
        for s in mc.skill_list():
            if s.get("name") == sname:
                mc.skill_delete(s["id"])
                print(f"deleted skill: {sname}")
    project_ids = state.get("project_ids") or {}
    if not project_ids and state.get("project_id"):
        project_ids = {manifest.project["name"]: state["project_id"]}
    for p in manifest.projects:
        pid = project_ids.get(p["name"])
        if not pid:
            for x in mc.project_list():
                if x.get("title") == p["name"]:
                    pid = x["id"]
                    break
        if pid:
            try:
                mc.project_delete(pid)
                print(f"deleted project: {p['name']}")
            except MulticaError as e:
                print(f"project {p['name']}: {e}")
    if ws_id and not str(ws_id).startswith("dry"):
        print(f"note: workspace deletion is not possible via CLI — remove "
              f"'{ws_slug}' from the multica.ai web UI if it was newly created.")
    state_path = state_path_for(manifest, args.state)
    if mode == "file" and state_path.exists():
        state_path.unlink()
    print("teardown complete")
    return 0


# ---------------------------------------------------------------------------
# init — interactive (or flag-driven) manifest authoring
# ---------------------------------------------------------------------------

def slugify(name):
    s = re.sub(r"[^a-z0-9]+", "-", (name or "").lower()).strip("-")
    return re.sub(r"-{2,}", "-", s)


def derive_prefix(name):
    parts = re.findall(r"[A-Za-z]", (name or "").strip())
    words = re.split(r"\s+", (name or "").strip())
    initials = "".join(w[0] for w in words if w[:1].isupper()) or "".join(parts[:3])
    return (initials or "MP")[:3].upper()


_stdin_eof = False


def ask(prompt, default=None):
    global _stdin_eof
    if _stdin_eof:
        return default or ""
    suffix = f" [{default}]" if default not in (None, "") else ""
    try:
        line = input(f"{prompt}{suffix}: ")
    except EOFError:
        _stdin_eof = True
        return default or ""
    line = line.strip()
    if not line:
        return default or ""
    return line


def ask_required(prompt, default=None):
    global _stdin_eof
    while True:
        if _stdin_eof:
            return default or ""
        v = ask(prompt, default)
        if v:
            return v
        print("  (required — please enter a value)")


def ask_choice(prompt, options, default_index=0):
    global _stdin_eof
    for i, o in enumerate(options):
        mark = "*" if i == default_index else " "
        print(f"  {mark} [{i + 1}] {o}")
    lo = str(default_index + 1)
    while True:
        if _stdin_eof:
            return default_index
        try:
            v = input(f"{prompt} (1-{len(options)}): ").strip() or lo
        except EOFError:
            _stdin_eof = True
            return default_index
        if v.isdigit() and 1 <= int(v) <= len(options):
            return int(v) - 1
        for i, o in enumerate(options):
            if v.lower() == str(o).lower():
                return i
        print("  (invalid choice)")


def ask_yesno(prompt, default=True):
    global _stdin_eof
    if _stdin_eof:
        return False
    d = "Y/n" if default else "y/N"
    try:
        v = input(f"{prompt} [{d}]: ").strip().lower()
    except EOFError:
        # never auto-proceed chained actions when input runs out
        _stdin_eof = True
        return False
    if not v:
        return default
    return v in ("y", "yes")


def ask_toggle(prompt, names, defaults):
    shown = "  ".join(f"[{'x' if n in defaults else ' '}] {n}" for n in names)
    v = ask(prompt + " " + shown + " — Enter to accept, or a comma list ('none' = all off):")
    if not v:
        return list(defaults)
    if v.strip().lower() in ("none", "off", "-"):
        return []
    sel = [n.strip() for n in v.split(",") if n.strip()]
    unknown = [n for n in sel if n not in names]
    if unknown:
        print(f"  ignoring unknown: {', '.join(unknown)}")
    out = [n for n in sel if n in names]
    if not out:
        return list(defaults)
    return out


def pick_runtime(role_label, runtimes, auto, fixed=None, missing=None):
    """Returns the runtime spec string for a role; '' if undetermined (auto mode)."""
    global _stdin_eof
    if fixed:
        return fixed
    if runtimes:
        opts = [f"{r.get('name') or r['id']} — {r.get('provider')} ({r.get('status')})"
                for r in runtimes]
        online_idx = [i for i, r in enumerate(runtimes) if r.get("status") == "online"]
        di = online_idx[0] if online_idx else 0
        if auto:
            return runtimes[di]["provider"]
        for k, o in enumerate(opts):
            mark = "*" if k == di else " "
            print(f"  {mark} [{k + 1}] {o}")
        i = di
        while True:
            if _stdin_eof:
                break
            try:
                v = input(f"  {role_label} runtime (1-{len(runtimes)} or provider name): ").strip()
            except EOFError:
                _stdin_eof = True
                break
            if not v:
                v = str(di + 1)
            if v.isdigit() and 1 <= int(v) <= len(runtimes):
                i = int(v) - 1
                break
            matched = None
            for k, r in enumerate(runtimes):
                cands = {str(opts[k]).lower()}
                if r.get("provider"):
                    cands.add(r["provider"].lower())
                if r.get("name"):
                    cands.add(r["name"].lower())
                if v.lower() in cands:
                    matched = k
                    break
            if matched is None:
                print("  (invalid choice)")
                continue
            i = matched
            break
        print(f"  (binding provider '{runtimes[i]['provider']}')")
        return runtimes[i]["provider"]
    # no runtimes (e.g. brand-new workspace before daemon sync)
    if auto:
        if missing is not None:
            msg = "--runtime <provider> (no runtimes in the target workspace yet)"
            if msg not in missing:
                missing.append(msg)
            return ""
        raise ManifestError(
            f"no runtimes in this workspace yet — "
            f"re-run after the daemon registers runtimes, or pick a provider below")
    v = ask_required("  no runtimes in this workspace yet (daemon may still be syncing) — "
                     "enter a provider to bind (e.g. opencode, grok, pi, claude, codex)")
    return v


def local_tz():
    try:
        import time as _t
        if _t.tzname and _t.tzname[0]:
            return _t.tzname[0]
    except Exception:
        pass
    return "UTC"


TEAM_VERBS = [
    "Bouncing", "Cackling", "Charging", "Cuddling", "Dashing", "Dreaming",
    "Fidgeting", "Foraging", "Galloping", "Gliding", "Giggling", "Grinning",
    "Grumbling", "Hatching", "Herding", "Howling", "Juggling", "Jolting",
    "Leaping", "Looming", "Moseying", "Nibbling", "Pouncing", "Prowling",
    "Rocketing", "Rumbling", "Sneaking", "Skating", "Tinkering", "Tumbling",
]

TEAM_ANIMALS = [
    "Badger", "Bobcat", "Camel", "Capybara", "Coyote", "Crane",
    "Dolphin", "Dragon", "Eagle", "Ferret", "Fox", "Gecko",
    "Goose", "Heron", "Hyena", "Jaguar", "Koala", "Lemur",
    "Lizard", "Lynx", "Mantis", "Moose", "Otter", "Owl",
    "Panda", "Penguin", "Quokka", "Raccoon", "Sloth", "Whale",
]


def random_team_name(taken=None):
    """A fun VERB + ANIMAL squad name, rerolled past any existing names."""
    while True:
        name = f"{random.choice(TEAM_VERBS)} {random.choice(TEAM_ANIMALS)}"
        if taken and name in taken:
            continue
        return name


# Returned by cmd_init when the interactive wizard finished a full run
# (check -> plan -> apply -> optional smoke); the caller exits to the shell
# instead of looping back to the main menu.
_WIZARD_DONE = object()


def cmd_init(args):
    auto = args.auto
    mc = make_mc(args)
    missing = []

    # ---- workspace ---------------------------------------------------------
    if args.workspace:
        ws = {"mode": "existing", "slug": args.workspace}
    elif args.new_workspace:
        ws_slug = args.slug or slugify(args.new_workspace)
        ws = {"mode": "new", "name": args.new_workspace, "slug": ws_slug,
              "issue_prefix": args.issue_prefix or derive_prefix(args.new_workspace)}
        if args.workspace_description:
            ws["description"] = args.workspace_description
    elif auto:
        missing.append("--workspace or --new-workspace (workspace)")
        ws = {"mode": "new", "name": "unnamed", "slug": "unnamed", "issue_prefix": "UN"}
    else:
        choice = ask_choice("Workspace", ["existing workspace", "new workspace"], default_index=0)
        if choice == 0:
            wss = mc.workspace_list()
            if not wss:
                print("  no workspaces found — create one (option 2)")
                choice = 1
        if choice == 0:
            i = ask_choice("  pick your workspace", [f"{w['name']} ({w['slug']})" for w in wss])
            ws = {"mode": "existing", "slug": wss[i]["slug"]}
        else:
            name = ask_required("  workspace name")
            ws = {"mode": "new", "name": name,
                  "slug": slugify(name),
                  "issue_prefix": derive_prefix(name)}

    # resolve target ws id + runtimes
    ws_id = None
    runtimes = []
    mc_scoped = mc
    try:
        ws_id = target_workspace_id(mc, args, None) if args.workspace else None
        if ws_id is None and not args.workspace:
            if ws.get("mode") == "existing":
                for w in mc.workspace_list():
                    if w.get("slug") == ws["slug"] or w.get("id") == ws["slug"]:
                        ws_id = w["id"]
                        break
            elif ws.get("mode") == "new":
                for w in mc.workspace_list():
                    if w.get("slug") == ws["slug"]:
                        ws_id = w["id"]
                        break
    except ManifestError:
        pass
    if ws_id and not str(ws_id).startswith("dry"):
        mc_scoped = Multica(workspace_id=ws_id, profile=args.profile)
        runtimes = mc_scoped.runtime_list()
        if not runtimes and ws.get("mode") == "new":
            print("note: the new workspace has no runtimes yet — the daemon may need a "
                  "re-login/restart; you can still pick a provider for now.")

# ---- project (name only — the rest rides on the defaults question) ------
    if args.project:
        p_name = args.project
    elif auto:
        missing.append("--project (project name)")
        p_name = ""
    else:
        p_name = ask_required("Project name")

    skeleton = (f"{p_name or 'The project'}. Boundaries: work happens in the registered "
                f"repositories; anything that touches production, costs money, or changes "
                f"direction needs the owner's explicit approval on the issue.")
    p_desc = args.description or skeleton
    repos = list(args.repos or [])

    if not auto and not repos:
        print("\nGit repositories (optional; enables git AP catalog entries if you opt in):")
        while True:
            try:
                line = input("  one URL per line, blank line to skip: ").strip()
            except EOFError:
                break
            if not line:
                break
            repos.append(line)

    mcp_sel = []
    if args.mcp:
        for n in (s.strip() for s in args.mcp.split(",") if s.strip()):
            if (MCP_DIR / f"{n}.json").exists():
                mcp_sel.append(n)
            elif auto:
                missing.append(f"valid --mcp presets (available: {', '.join(MCP_PRESETS)}; got '{n}')")
            else:
                print(f"  (skipping unknown mcp preset '{n}' — available: {', '.join(MCP_PRESETS)})")
    elif not args.no_mcp:
        mcp_sel = list(MCP_PRESETS)

    # ---- defaults summary ------------------------------------------------------
    all_roles = list(ROLES)
    tz = local_tz()
    default_ap = (
        {"key": "daily-standup", "name": "Daily standup", "assignee_role": "lead",
         "mode": "create_issue", "cron": "30 8 * * 1-5", "timezone": tz,
         "issue_title": "Standup — {{date}}"},
    )
    ap_catalog = default_ap + tuple(dict(d, timezone=tz) for d in OPTIONAL_AP_DEFS)
    if repos:
        ap_catalog += tuple(dict(d, timezone=tz) for d in GIT_AP_DEFS)
    pool = [r for r in runtimes if r.get("status") == "online"] or runtimes
    default_rt = args.runtime or (pool[0]["provider"] if pool else "")
    taken_squads = set()
    if ws_id and not str(ws_id).startswith("dry"):
        try:
            taken_squads = {s.get("name") for s in mc_scoped.squad_list() if s.get("name")}
        except MulticaError:
            pass
    squad_name = args.squad or random_team_name(taken_squads)

    uses_defaults = auto
    if not auto:
        if ws.get("mode") == "new":
            ws_disp = f"{ws['name']} (new — slug {ws['slug']}, prefix {ws['issue_prefix']})"
        else:
            ws_disp = ws["slug"]
        rt_disp = default_rt or "(no online runtimes yet — you'll be asked for a provider)"
        desc_disp = p_desc if len(p_desc) <= 78 else p_desc[:75] + "..."
        print(f"\nDefaults for workspace {ws_disp}:")
        print(f"  project:      {p_name}")
        print(f"  description:  {desc_disp}")
        print(f"  repos:        {', '.join(repos) if repos else '(none)'}")
        print(f"  team:         {squad_name} — {', '.join(ROLES)}")
        print(f"  runtimes:     each on {rt_disp}, model: {args.model or 'runtime default'}")
        if args.no_autopilots:
            print("  autopilots:   (off — --no-autopilots)")
        else:
            for a in default_ap:
                print(f"  autopilot:    {a['name']}  ({a['cron']}, {a['timezone']})")
            opt_names = [a["name"] for a in ap_catalog if a["key"] not in {d["key"] for d in default_ap}]
            if opt_names:
                print(f"  note:         other autopilots off by default ({', '.join(opt_names)})")
                print("                — enable them in customize (n) or add to the manifest later")
        if ws.get("mode") == "new" and len(ws["slug"]) < 4:
            print("  hint:         short slugs are often already taken globally on Multica Cloud — a longer, unique slug is safer")
        if mcp_sel:
            print(f"  mcp:          {', '.join(mcp_sel)} (attached to all roles; the customize step can change this)")
        else:
            print("  mcp:          (off — re-enable with --mcp context7,firecrawl)")
        uses_defaults = ask_yesno("\nProceed with defaults? (n = customize)", True)

    if not auto and not uses_defaults:
        # customize: override anything the summary showed
        p_desc = args.description or ask(
            "Project description (goal + boundaries; enters every run's context)", skeleton)
        if ws.get("mode") == "new":
            ws["slug"] = ask("  workspace slug", ws["slug"])
            ws["issue_prefix"] = ask("  issue prefix", ws["issue_prefix"])
            d = ask("  workspace description (optional)")
            if d:
                ws["description"] = d
        print("Repos (one URL per line, blank line when done):")
        while True:
            try:
                line = input("  ").strip()
            except EOFError:
                break
            if not line:
                break
            repos.append(line)

    # ---- team ----------------------------------------------------------------
    if auto:
        if args.roles:
            selected = [r.strip() for r in args.roles.split(",") if r.strip()]
            bad = [r for r in selected if r not in ROLES]
            if bad:
                missing.append(f"valid roles for --roles (got: {', '.join(bad)})")
                selected = []
            if "lead" not in selected and selected:
                selected.append("lead")
        else:
            selected = all_roles
    elif uses_defaults:
        selected = all_roles
    else:
        selected = ask_toggle("Team roles", all_roles, all_roles)
        if "lead" not in selected:
            selected.append("lead")
            print("  (lead is required — added it back)")
    selected = [r for r in all_roles if r in selected]

    if not auto and uses_defaults and not default_rt:
        default_rt = ask_required("  which provider should the team bind to? "
                                  "(e.g. opencode, grok, pi, claude, codex)")

    roles_out = []
    for role in selected:
        label = f"{ROLES[role]} ({role})"
        if auto or uses_defaults:
            name = ROLES[role]
        else:
            name = ask(f"  {label} agent name", ROLES[role])
        if auto:
            rt_spec = pick_runtime(label, runtimes, True, fixed=args.runtime, missing=missing)
        elif uses_defaults:
            rt_spec = default_rt
        else:
            rt_spec = pick_runtime(label, runtimes, auto, fixed=args.runtime, missing=None)
        if auto and not rt_spec:
            continue
        if auto or uses_defaults:
            model = args.model or None
        else:
            m = ask(f"  {label} model (blank = runtime default)", "")
            model = m or None
        entry = {"role": role, "name": name, "runtime": rt_spec,
                 "max_concurrent_tasks": 1}
        if role == "helper":
            entry["in_squad"] = False
        if model:
            entry["model"] = model
        roles_out.append(entry)

    if not auto and not uses_defaults:
        squad_name = ask(f"  team name (Enter keeps {squad_name})", squad_name) or squad_name

    skills = [
        {"name": "multica-cli", "source": "url",
         "url": "https://github.com/multica-ai/multica-cli/tree/main/skills/multica-cli",
         "attach_to": "all"},
        {"name": "handoff-protocol", "source": "local", "attach_to": "all"},
        {"name": "kanban-contract", "source": "local", "attach_to": "all"},
        {"name": "role-contract", "source": "local", "attach_to": "all"},
        {"name": "pr-conventions", "source": "local",
         "attach_to": ["lead", "engineer", "reviewer", "qa", "release", "docs"]},
        {"name": "delivery-report", "source": "local", "attach_to": "all"},
    ]

    # ---- autopilots ------------------------------------------------------------
    catalog = [dict(a) for a in ap_catalog]
    if repos and "docs" in selected:
        for a in catalog:
            if a["key"] == "docs-check":
                a["assignee_role"] = "docs"
    aps = []
    if not args.no_autopilots:
        if auto or uses_defaults:
            aps = [dict(a) for a in default_ap]
        else:
            keys = [a["key"] for a in catalog]
            default_keys = [a["key"] for a in default_ap]
            picked = ask_toggle("Autopilots", keys, default_keys)
            for key in picked:
                ap = dict(next(a for a in catalog if a["key"] == key))
                ap["cron"] = ask(f"  {key} cron", ap["cron"])
                ap["timezone"] = ask(f"  {key} timezone", ap["timezone"])
                aps.append(ap)
        if auto:
            print("note: autopilots default to daily-standup only")
            print("      (add weekly-hygiene / stall-radar / pr-patrol / docs-check in the manifest to opt in)")

    # ---- mcp --------------------------------------------------------------------
    if not auto and not uses_defaults:
        mcp_sel = ask_toggle("MCP servers (presets in templates/mcp/; 'none' = off)", MCP_PRESETS, mcp_sel)
    if auto:
        if mcp_sel:
            print(f"note: mcp servers enabled: {', '.join(mcp_sel)}")
        elif args.no_mcp:
            print("note: mcp servers disabled (--no-mcp)")
    if "context7" in mcp_sel and not shutil.which("node"):
        if auto:
            print(f"note: context7 needs node on the runtime machine — not found on this one ({detect_node_install()})")
        else:
            print(f"note: context7 needs node+npx on the runtime machine — not found on this one.")
            print(f"      this machine: {detect_node_install()}")
            print("      other runtime machines: install node there yourself — the tool cannot reach them")
            choice = ask_choice("What now?", ["install on this machine now", "skip — I'll handle it"], default_index=1)
            if choice == 0:
                cmd = node_install_command()
                if not cmd:
                    print(f"note: no known package manager here — install manually: {detect_node_install()}")
                else:
                    print(f"running: {' '.join(cmd)}")
                    rc = subprocess.run(cmd).returncode
                    if rc != 0 or not shutil.which("node"):
                        print("note: node still missing — context7 will not work on this machine until it is installed")
    if "context7" in mcp_sel and shutil.which("npx") and not auto:
        if ask_yesno("Warm the context7 package cache now (avoids a slow first agent run)?", True):
            print("warming context7 package cache (first run may take a minute)...")
            try:
                subprocess.run(["npx", "-y", "@upstash/context7-mcp", "--version"],
                               timeout=300, capture_output=True)
            except (OSError, subprocess.SubprocessError) as e:
                print(f"note: cache warm failed ({e}) — the first agent run will download it instead")

    firecrawl_with_key = False
    if "firecrawl" in mcp_sel:
        if not auto:
            print("note: firecrawl's keyless tier is rate-limited; a key raises the limit")
            if ask_yesno("Provide a Firecrawl API key now?", False):
                key = ask_required("  Firecrawl API key")
                env_path = save_local_env_var("FIRECRAWL_API_KEY", key)
                firecrawl_with_key = True
                print(f"note: saved to {env_path} (gitignored) for later applies — "
                      "never written to the manifest")
            else:
                print("note: installing firecrawl keyless")
        elif os.environ.get("FIRECRAWL_API_KEY"):
            firecrawl_with_key = True
            print("note: firecrawl will use FIRECRAWL_API_KEY from the environment "
                  f"(or {LOCAL_ENV_NAME})")
        else:
            print(f"note: firecrawl enabled keyless (put FIRECRAWL_API_KEY in {LOCAL_ENV_NAME} "
                  "or the environment before apply to raise limits)")

    if missing:
        print("init: missing required information for --auto mode:")
        for m in missing:
            print(f"  - {m}")
        print("(re-run with these flags, or without --auto for the interactive flow)")
        return 1

    # ---- write manifest ----------------------------------------------------------
    manifest_dict = {
        "workspace": ws,
        "project": {"name": p_name, "description": p_desc, "repos": repos,
                    "lead_role": "lead"},
        "team": {"squad_name": squad_name, "routing": "hybrid",
                 "roles": roles_out, "skills": skills},
        "autopilots": aps,
    }
    if mcp_sel:
        servers = {n: json.loads((MCP_DIR / f"{n}.json").read_text(encoding="utf-8"))
                   for n in mcp_sel}
        if firecrawl_with_key and "firecrawl" in servers:
            servers["firecrawl"] = {
                "url": "https://mcp.firecrawl.dev/mcp",
                "headers": {"Authorization": "Bearer ${FIRECRAWL_API_KEY}"},
            }
        manifest_dict["mcp"] = {"servers": servers, "attach_to": "all"}
    out_path = None
    if args.in_project:
        # spec will be stored in the project's description by apply — no file
        man = parse_manifest(manifest_dict, Path("."))
    else:
        out_path = Path(args.out) if args.out else Path((ws.get("slug") or "project") + ".json")
        if out_path.exists() and not args.force:
            print(f"init: {out_path} exists — use --force to overwrite (or --out FILE)")
            return 1
        out_path.write_text(json.dumps(manifest_dict, indent=2, ensure_ascii=False) + "\n")
        print(f"\nmanifest written: {out_path}")
        man = load_manifest(out_path)

    # validate exactly the way check/plan will
    ctx = build_context(man)
    for r in man.roles:
        render_agent_instructions(man, r, ctx)
    render_squad_instructions(man, ctx)
    for ap in man.autopilots:
        render_runbook(man, ap["key"], ctx)
    print("manifest validated: templates render, roles and autopilots are sound")

    # ---- chain: check, plan, (apply, smoke) ----------------------------------------
    chain = argparse.Namespace(manifest=None if args.in_project else str(out_path),
                               workspace=ws.get("slug") if ws.get("mode") == "existing" else None,
                               profile=args.profile, state=args.state,
                               timeout=600, poll=10)
    if args.in_project:
        chain._spec = (man, manifest_dict)
        chain.project = p_name
    print("\n== check ==")
    rc = cmd_check(chain)
    if rc != 0:
        if args.in_project:
            print("\ncheck failed — fix the issues above, then re-run init.")
        else:
            print("\ncheck failed — fix the issues above (or re-run `check`), then apply:")
            print(f"  bin/multica-setup --manifest {out_path} apply")
        return rc
    print("\n== plan ==")
    rc = cmd_plan(chain)
    if rc != 0:
        return rc

    do_apply = not args.no_apply
    if auto:
        apply_now = do_apply
    elif not sys.stdin.isatty():
        # piped stdin can't express "yes, apply" reliably — on EOF every prompt
        # falls back to its default, so never auto-apply here
        apply_now = False
        if do_apply:
            print("\nnote: non-interactive stdin — apply skipped. Re-run interactively,")
            print("or use --auto (explicit) for scripted runs.")
    else:
        apply_now = do_apply and ask_yesno("\nRun apply now?", True)
    if apply_now:
        rc = cmd_apply(chain)
        if rc != 0:
            return rc
        if not args.no_kickoff:
            print()
            rc = cmd_kickoff(chain)
            if rc != 0:
                return rc
        if args.smoke:
            print()
            cmd_smoke(chain)
        return _WIZARD_DONE
    else:
        if args.in_project:
            print("\nwarning: --in-project stores the spec in the project's description, but")
            print("apply did not run — nothing was persisted to Multica. Re-run init to try again.")
        else:
            print("\nskipping apply — run it when ready:")
            print(f"  bin/multica-setup --manifest {out_path} apply")
            print(f"  bin/multica-setup --manifest {out_path} smoke")
    return 0


def discover_manifests(dirpath="."):
    """(path, manifest) pairs for every loadable manifest in dirpath."""
    out = []
    for p in sorted(Path(dirpath).glob("*.json")):
        try:
            out.append((p, load_manifest(p)))
        except ManifestError:
            continue
    return out


def menu_init_wizard():
    args = argparse.Namespace(auto=False, workspace=None, new_workspace=None, slug=None,
                              issue_prefix=None, workspace_description=None, project=None,
                              description=None, repos=None, roles=None, runtime=None,
                              model=None, squad=None, no_autopilots=False, no_apply=False,
                              no_kickoff=False, smoke=False, out=None, force=True,
                              profile=None, state=None, manifest=None, in_project=False,
                              mcp=None, no_mcp=False, timeout=600, poll=10)
    rc = cmd_init(args)
    if rc is _WIZARD_DONE:
        print("\ngood luck with your project")
        print("the Lead will open a Kickoff: issue and ping you — tell it what to start with")
        return True
    return False


def run_project_actions(source, profile=None):
    """check/plan/apply/status/smoke/kickoff/teardown loop for one project spec.

    source is {"manifest": path} (file mode) or
    {"workspace": slug, "project": title} (spec read back via the CLI)."""
    handlers = {"check": cmd_check, "plan": cmd_plan, "apply": cmd_apply,
                "status": cmd_status, "smoke": cmd_smoke, "kickoff": cmd_kickoff,
                "teardown": cmd_teardown}
    is_file = "manifest" in source
    while True:
        if is_file:
            try:
                man = load_manifest(Path(source["manifest"]))
            except ManifestError as e:
                print(f"  spec no longer loadable: {e}")
                return
            ws = man.workspace.get("slug") or man.workspace.get("name") or "?"
            header = (f"{Path(source['manifest']).name} — workspace {ws}, "
                      f"project {', '.join(pr.get('name', '?') for pr in man.projects)}")
        else:
            header = (f"workspace {source['workspace']} / project {source.get('project')} "
                      f"(spec in project description)")
        print(f"\n== {header} ==")
        print("  1) check   2) plan   3) apply   4) status   5) smoke   6) kickoff   7) teardown   b) back")
        try:
            v = input("action [1-7/b]: ").strip().lower()
        except EOFError:
            return
        if v in ("b", "back", "q", "quit"):
            return
        if not v:
            continue
        if v not in ("1", "2", "3", "4", "5", "6", "7"):
            print("  (pick 1-7 or b)")
            continue
        name = {"1": "check", "2": "plan", "3": "apply", "4": "status",
                "5": "smoke", "6": "kickoff", "7": "teardown"}[v]
        yes = False
        if name == "teardown":
            if not ask_yesno("  archive everything this tool created in this workspace?", False):
                print("  (teardown cancelled)")
                continue
            yes = True
        args = argparse.Namespace(manifest=str(source["manifest"]) if is_file else None,
                                  workspace=None if is_file else source["workspace"],
                                  project=source.get("project"), profile=profile,
                                  state=None, timeout=600, poll=10, yes=yes)
        try:
            handlers[name](args)
        except (ManifestError, MulticaError) as e:
            print(f"error: {e}")


def interactive_menu(preset_manifest=None, profile=None):
    if preset_manifest:
        run_project_actions({"manifest": Path(preset_manifest).expanduser()}, profile)
    while True:
        print("\n" + "-" * 52)
        print("multica-setup — bootstrap & manage Multica project teams")
        print("-" * 52)
        print("  1) Start a new project")
        print("  2) Work with an existing project")

        # Live workspaces from the multica CLI are the source of truth;
        # local manifest files only annotate them (desired-state specs).
        live = None
        try:
            live = Multica(profile=profile).workspace_list()
        except MulticaError as e:
            print(f"  note: cannot reach the multica CLI ({str(e).splitlines()[0]}) — "
                  "listing local specs instead")
        manifests = discover_manifests()
        by_slug = {}
        for p, m in manifests:
            s = m.workspace.get("slug")
            if s:
                by_slug.setdefault(s, p)
        options = []
        if live:
            for w in live:
                slug = w.get("slug") or ""
                options.append({"slug": slug, "manifest": by_slug.get(slug),
                                "label": f"{w.get('name')} ({slug})"})
        else:
            for p, m in manifests:
                ws = m.workspace.get("slug") or m.workspace.get("name") or "?"
                options.append({"slug": ws, "manifest": p, "label": p.name})
        if not options:
            print("     (none found)")
        for i, o in enumerate(options, 1):
            o["n"] = i
            if live:
                mark = (f"manifest: {o['manifest'].name}" if o["manifest"]
                        else "no local manifest")
                print(f"     [{i}] {o['label']}  ({mark})")
            else:
                print(f"     [{i}] {o['label']}  (workspace {o['slug']})")
        if live:
            matched = {o["manifest"] for o in options if o["manifest"]}
            dangling = [p for p in by_slug.values() if p not in matched]
            if dangling:
                print("  local specs with no workspace in this account: "
                      + ", ".join(p.name for p in dangling)
                      + " — use `--manifest <file>`")
        print("  q) Quit")
        try:
            v = input("\nchoice [1/2/q]: ").strip().lower()
        except EOFError:
            print("\nno interactive input. For direct runs use:")
            print("  bin/multica-setup init        # guided wizard")
            print("  bin/multica-setup --help      # all subcommands")
            return 0
        if v in ("q", "quit", "exit"):
            print("bye")
            return 0
        if v in ("", "1"):
            try:
                if menu_init_wizard():
                    return 0
            except (ManifestError, MulticaError) as e:
                print(f"error: {e}")
        elif v == "2":
            sel = None
            if len(options) == 1:
                sel = options[0]
            elif options:
                mv = ask("workspace (number or slug)", "")
                if not mv:
                    continue
                mv_l = mv.lower()
                for o in options:
                    if str(o["n"]) == mv or o["slug"].lower() == mv_l:
                        sel = o
                        break
                if sel is None and not live:
                    t = Path(mv).expanduser()
                    if t.exists():
                        sel = {"slug": mv, "manifest": t, "label": t.name}
            if sel is None:
                print("  no matching workspace")
                continue
            if sel.get("manifest"):
                run_project_actions({"manifest": Path(sel["manifest"]).expanduser()}, profile)
            else:
                slug = sel["slug"]
                managed = []
                try:
                    managed = list_managed_projects(slug, profile)
                except (ManifestError, MulticaError) as e:
                    print(f"  {str(e).splitlines()[0]}")
                if managed:
                    print(f"  projects managed by multica-setup in {slug}:")
                    for i, t in enumerate(managed, 1):
                        print(f"     [{i}] {t}")
                    try:
                        pv = input("project (number): ").strip()
                    except EOFError:
                        continue
                    if not (pv.isdigit() and 1 <= int(pv) <= len(managed)):
                        print("  (number only)")
                        continue
                    run_project_actions({"workspace": slug, "project": managed[int(pv) - 1]}, profile)
                else:
                    try:
                        cmd_status(argparse.Namespace(manifest=None, workspace=slug,
                                                      profile=profile))
                    except (ManifestError, MulticaError) as e:
                        print(f"error: {e}")
                    print(f"\nno local manifest for '{slug}' — to manage it with this kit:")
                    print(f"  bin/multica-setup init --workspace {slug}")
        else:
            print("  (1, 2, or q)")


def main(argv=None):
    load_local_env()
    ap = argparse.ArgumentParser(prog="multica-setup",
                                 description="Bootstrap a working Multica project team via the multica CLI. "
                                              "With no subcommand, runs the interactive menu.")
    ap.add_argument("--manifest", help="path to project manifest JSON")
    ap.add_argument("--workspace", help="override target workspace (slug or ID)")
    ap.add_argument("--project", help="project title (with --workspace: selects the managed project whose spec lives in its description)")
    ap.add_argument("--profile", help="multica CLI profile to use")
    ap.add_argument("--state", help="state file path (default: <manifest dir>/.multica-bootstrap-state.json)")
    sub = ap.add_subparsers(dest="cmd")

    ini = sub.add_parser("init", help="interactive: author a manifest, then check/plan/apply/kickoff/smoke")
    ini.add_argument("--new-workspace", help="create a new workspace with this name")
    ini.add_argument("--slug", help="slug for the new workspace (default: derived from name)")
    ini.add_argument("--issue-prefix", help="issue prefix for the new workspace (default: derived)")
    ini.add_argument("--workspace-description", help="description for the new workspace")
    ini.add_argument("--project", help="project name")
    ini.add_argument("--description", help="project description")
    ini.add_argument("--repos", nargs="*", help="repository URLs")
    ini.add_argument("--mcp", help="comma list of MCP presets to enable (default: all presets)")
    ini.add_argument("--no-mcp", action="store_true", help="disable all MCP servers (default: presets enabled)")
    ini.add_argument("--roles", help="comma list of roles (lead is required), e.g. lead,engineer,reviewer")
    ini.add_argument("--runtime", help="runtime provider bound to all roles (e.g. opencode, grok, pi)")
    ini.add_argument("--model", help="model for all roles (default: runtime default)")
    ini.add_argument("--squad", help="squad name (default: '<project> Team')")
    ini.add_argument("--no-autopilots", action="store_true", help="skip the default autopilots")
    ini.add_argument("--in-project", action="store_true",
                     help="store the spec in the project's description (no local manifest file; "
                          "later commands use --workspace/--project)")
    ini.add_argument("--auto", action="store_true", help="non-interactive: answer everything from flags/defaults")
    ini.add_argument("--no-apply", action="store_true", help="stop after check+plan, do not run apply")
    ini.add_argument("--no-kickoff", action="store_true", help="skip the kickoff issue after apply")
    ini.add_argument("--smoke", action="store_true", help="run the smoke test after apply (with --auto)")
    ini.add_argument("--out", help="manifest output path (default: <workspace-slug>.json)")
    ini.add_argument("--force", action="store_true", help="overwrite an existing manifest file")

    sub.add_parser("check", help="pre-flight checks (read-only)")
    sub.add_parser("plan", help="show what apply would do (read-only)")
    sub.add_parser("apply", help="create/update everything (idempotent)")
    sub.add_parser("status", help="show live workspace state")
    sp = sub.add_parser("smoke", help="run a throwaway issue through the squad")
    sp.add_argument("--timeout", type=int, default=600, help="max wait seconds (default 600)")
    sp.add_argument("--poll", type=int, default=10, help="poll interval seconds (default 10)")
    sub.add_parser("kickoff", help="open the kickoff issue: the lead pings the owner to start work")
    st = sub.add_parser("teardown", help="archive what this tool created")
    st.add_argument("--yes", action="store_true", help="actually do it")

    args = ap.parse_args(argv)
    if args.cmd is None:
        # no subcommand: run the interactive menu (--manifest jumps straight in)
        return interactive_menu(preset_manifest=args.manifest, profile=args.profile)
    if args.cmd not in ("status", "check", "init") and not args.manifest and not args.workspace:
        ap.error(f"--manifest <file> or --workspace <slug> is required for '{args.cmd}'")
    if args.cmd == "check" and not args.manifest and not args.workspace:
        ap.error("check needs --manifest or --workspace")

    handlers = {"init": cmd_init, "check": cmd_check, "plan": cmd_plan, "apply": cmd_apply,
                "status": cmd_status, "smoke": cmd_smoke, "kickoff": cmd_kickoff,
                "teardown": cmd_teardown}
    try:
        rc = handlers[args.cmd](args)
        return 0 if rc is _WIZARD_DONE else rc
    except (ManifestError, MulticaError) as e:
        print(f"error: {e}")
        return 1
    except KeyboardInterrupt:
        print("\ninterrupted")
        return 130


if __name__ == "__main__":
    sys.exit(main())
